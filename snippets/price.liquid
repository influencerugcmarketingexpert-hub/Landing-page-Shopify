{%- liquid
  assign t = target | default: product
  if t.object_type == nil
    assign on_sale = false
    assign price = t.price | default: 0
    echo price | money
  else
    if t.object_type == 'line_item'
      echo t.final_line_price | money
    else
      assign on_sale = false
      if t.compare_at_price > t.price
        assign on_sale = true
      endif
      if on_sale
        echo '<span class="price"><span class="price__sale">' | append: t.price | money | append: '</span> <span class="price__compare">' | append: t.compare_at_price | money | append: '</span></span>'
      else
        echo '<span class="price">' | append: t.price | money | append: '</span>'
      endif
    endif
  endif
-%}
