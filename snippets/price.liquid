{%- liquid
  assign t = target | default: product
-%}
{%- if t == blank -%}
  <span class="price">{{ 0 | money }}</span>
{%- elsif t.object_type == 'line_item' -%}
  <span class="price">{{ t.final_line_price | money }}</span>
{%- else -%}
  {%- if t.compare_at_price > t.price -%}
    <span class="price">
      <span class="price__sale">{{ t.price | money }}</span>
      <span class="price__compare">{{ t.compare_at_price | money }}</span>
    </span>
  {%- else -%}
    <span class="price">{{ t.price | money }}</span>
  {%- endif -%}
{%- endif -%}
