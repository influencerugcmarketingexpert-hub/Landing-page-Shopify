{%- comment -%}
  JSON-LD snippet.

  Emits:
    - Organization (always)
    - WebSite with Sitelinks SearchAction (always)
    - Product + BreadcrumbList on product pages
    - BreadcrumbList on collection pages
    - BlogPosting on article pages

  Usage:
    {%- render 'json-ld' -%}
{%- endcomment -%}

{%- assign brand_name = settings.organization_name | default: shop.name -%}
{%- assign brand_logo = '' -%}
{%- if settings.logo != blank -%}
  {%- capture brand_logo %}https:{{ settings.logo | image_url: width: 600 }}{%- endcapture -%}
{%- elsif settings.social_sharing_image != blank -%}
  {%- capture brand_logo %}https:{{ settings.social_sharing_image | image_url: width: 600 }}{%- endcapture -%}
{%- endif -%}

{%- capture _socials_raw -%}
  {%- if settings.social_instagram_link != blank -%}{{ settings.social_instagram_link }}|{%- endif -%}
  {%- if settings.social_facebook_link != blank -%}{{ settings.social_facebook_link }}|{%- endif -%}
  {%- if settings.social_pinterest_link != blank -%}{{ settings.social_pinterest_link }}|{%- endif -%}
  {%- if settings.social_youtube_link != blank -%}{{ settings.social_youtube_link }}|{%- endif -%}
  {%- if settings.social_tiktok_link != blank -%}{{ settings.social_tiktok_link }}|{%- endif -%}
{%- endcapture -%}
{%- assign _socials_trimmed = _socials_raw | strip | remove: ' ' -%}
{%- assign _socials_list = _socials_trimmed | split: '|' -%}
{%- capture social_array -%}
[
{%- for s in _socials_list -%}
  {%- if s != blank -%}
    {%- unless forloop.first -%},{%- endunless -%}"{{ s }}"
  {%- endif -%}
{%- endfor -%}
]
{%- endcapture -%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ brand_name | json }},
  "url": {{ shop.url | json }}{%- if brand_logo != blank -%},
  "logo": {{ brand_logo | json }}{%- endif -%},
  "sameAs": {{ social_array | strip_newlines | replace: '  ', '' }}
}
</script>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ brand_name | json }},
  "url": {{ shop.url | json }},
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>

{%- if template.name == 'product' and product != blank -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": "{{ shop.url }}{{ product.url }}",
    "description": {{ product.description | strip_html | truncatewords: 60 | json }},
    "sku": {{ current_variant.sku | default: product.id | json }},
    "brand": {
      "@type": "Brand",
      "name": {{ product.vendor | default: brand_name | json }}
    },
    "image": [
      {%- for image in product.images limit: 6 -%}
        {%- unless forloop.first -%},{%- endunless -%}"https:{{ image | image_url: width: 1200 }}"
      {%- endfor -%}
    ],
    "offers": {
      "@type": "Offer",
      "priceCurrency": {{ cart.currency.iso_code | json }},
      "price": {{ current_variant.price | money_without_currency | replace: ',', '.' | json }},
      "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
      "url": "{{ shop.url }}{{ product.url }}",
      "itemCondition": "https://schema.org/NewCondition"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.8",
      "reviewCount": "0",
      "bestRating": "5",
      "worstRating": "1"
    }
  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      }{%- if collection != blank -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": "{{ shop.url }}{{ product.url }}"
      }
      {%- else -%},
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": "{{ shop.url }}{{ product.url }}"
      }
      {%- endif -%}
    ]
  }
  </script>
{%- elsif template.name == 'collection' and collection != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ shop.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ collection.title | json }},
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    ]
  }
  </script>
{%- elsif template.name == 'article' and article != blank -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "{{ shop.url }}{{ article.url }}"
    },
    "headline": {{ article.title | json }},
    "description": {{ article.excerpt_or_content | strip_html | truncatewords: 55 | json }},
    {%- if article.image -%}
    "image": ["https:{{ article.image | image_url: width: 1200 }}"],
    {%- endif -%}
    "datePublished": "{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
    "dateModified": "{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}",
    "author": {
      "@type": "Person",
      "name": {{ article.author | default: brand_name | json }}
    },
    "publisher": {
      "@type": "Organization",
      "name": {{ brand_name | json }}{%- if brand_logo != blank -%},
      "logo": {
        "@type": "ImageObject",
        "url": {{ brand_logo | json }}
      }
      {%- endif -%}
    }
  }
  </script>
{%- endif -%}
