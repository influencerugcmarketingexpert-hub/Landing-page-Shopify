{%- comment -%}
  Meta tags snippet.

  Emits <title>, meta description, canonical, OpenGraph, Twitter card, and
  product-specific OG/product tags when on a product template.

  Usage:
    {%- render 'meta-tags' -%}
{%- endcomment -%}

{%- assign og_title = page_title | default: shop.name -%}
{%- capture og_description -%}
  {%- if template.name == 'product' and product.description != blank -%}
    {{ product.description | strip_html | truncatewords: 40 }}
  {%- elsif template.name == 'collection' and collection.description != blank -%}
    {{ collection.description | strip_html | truncatewords: 40 }}
  {%- elsif template.name == 'article' and article.excerpt_or_content != blank -%}
    {{ article.excerpt_or_content | strip_html | truncatewords: 40 }}
  {%- elsif page_description != blank -%}
    {{ page_description }}
  {%- else -%}
    {{ shop.description | default: shop.name }}
  {%- endif -%}
{%- endcapture -%}

<title>
  {{- og_title -}}
  {%- unless og_title contains shop.name %} &middot; {{ shop.name }}{%- endunless -%}
</title>

{%- if og_description != blank -%}
  <meta name="description" content="{{ og_description | strip | escape }}">
{%- endif -%}

<link rel="canonical" href="{{ canonical_url }}">

{%- comment -%} OpenGraph basics {%- endcomment -%}
<meta property="og:site_name" content="{{ settings.organization_name | default: shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_description | strip | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">

{%- if template.name == 'product' -%}
  <meta property="og:type" content="product">
{%- elsif template.name == 'article' -%}
  <meta property="og:type" content="article">
  {%- if article.published_at -%}
    <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- endif -%}
  {%- if article.author != blank -%}
    <meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}
{%- else -%}
  <meta property="og:type" content="website">
{%- endif -%}

{%- comment -%} OG image resolution {%- endcomment -%}
{%- if template.name == 'product' and product.featured_image -%}
  {%- assign og_image = product.featured_image -%}
{%- elsif template.name == 'collection' and collection.image -%}
  {%- assign og_image = collection.image -%}
{%- elsif template.name == 'article' and article.image -%}
  {%- assign og_image = article.image -%}
{%- elsif settings.social_sharing_image -%}
  {%- assign og_image = settings.social_sharing_image -%}
{%- endif -%}

{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ og_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: og_image.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

{%- comment -%} Twitter {%- endcomment -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
{%- endif -%}
{%- if settings.social_twitter_link != blank -%}
  {%- comment -%}
    Accept both twitter.com and x.com URLs, plus bare @handle or handle.
    Strip protocol, then keep only the last path segment, then strip any
    leading '@' or query string. Emit twitter:site only when what remains
    is a plausible handle (non-empty, no '.' - which would mean we caught
    a hostname, not a handle).
  {%- endcomment -%}
  {%- assign twitter_handle = settings.social_twitter_link | default: '' | strip -%}
  {%- assign twitter_handle = twitter_handle | split: '://' | last -%}
  {%- assign twitter_handle = twitter_handle | split: '?' | first -%}
  {%- assign twitter_handle = twitter_handle | split: '#' | first -%}
  {%- assign twitter_handle = twitter_handle | split: '/' | last -%}
  {%- assign twitter_handle = twitter_handle | remove: '@' | strip -%}
  {%- if twitter_handle != blank and twitter_handle contains '.' == false -%}
    <meta name="twitter:site" content="@{{ twitter_handle }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%} Product-specific {%- endcomment -%}
{%- if template.name == 'product' and product != blank -%}
  {%- assign current_variant = product.selected_or_first_available_variant -%}
  <meta property="product:brand" content="{{ product.vendor | default: settings.organization_name | default: shop.name | escape }}">
  <meta property="product:availability" content="{% if current_variant.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
  <meta property="product:price:amount" content="{{ current_variant.price | money_without_currency | replace: ',', '.' }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  {%- if current_variant.sku != blank -%}
    <meta property="product:retailer_item_id" content="{{ current_variant.sku | escape }}">
  {%- endif -%}
  {%- if product.metafields.global.google_product_category != blank -%}
    <meta property="product:category" content="{{ product.metafields.global.google_product_category }}">
  {%- endif -%}
{%- endif -%}

{%- comment -%}
  Alternate locales.

  Shopify Markets supports path-prefixed localization (e.g. /fr/products/..)
  via `locale.root_url` and `request.locale.root_url`. Rebuilding the URL
  from `request.origin | append: locale.root_url | append: path_without_prefix`
  avoids the v1 bug where `replace_first: request.locale.iso_code, ...`
  corrupted any handle that happened to contain the source ISO as a
  substring (e.g. `/products/en-collar` on an en->fr swap).

  The x-default hreflang points at the store's primary locale.
{%- endcomment -%}
{%- if shop.published_locales.size > 1 -%}
  {%- assign current_root = request.locale.root_url | default: '/' -%}
  {%- assign locale_path = request.path | default: '/' -%}
  {%- if current_root != '/' -%}
    {%- assign current_root_len = current_root | size -%}
    {%- assign path_prefix = locale_path | slice: 0, current_root_len -%}
    {%- if path_prefix == current_root -%}
      {%- assign locale_path = locale_path | remove_first: current_root -%}
    {%- endif -%}
  {%- endif -%}
  {%- if locale_path == '' or locale_path == blank -%}
    {%- assign locale_path = '/' -%}
  {%- endif -%}
  {%- assign locale_path_first = locale_path | slice: 0, 1 -%}
  {%- unless locale_path_first == '/' -%}
    {%- assign locale_path = '/' | append: locale_path -%}
  {%- endunless -%}

  {%- for locale in shop.published_locales -%}
    {%- assign target_root = locale.root_url | default: '/' -%}
    {%- if target_root == '/' -%}
      {%- assign href = request.origin | append: locale_path -%}
    {%- else -%}
      {%- assign href = request.origin | append: target_root | append: locale_path -%}
    {%- endif -%}
    <link rel="alternate" hreflang="{{ locale.iso_code }}" href="{{ href }}">
    {%- if locale.primary -%}
      <link rel="alternate" hreflang="x-default" href="{{ href }}">
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
