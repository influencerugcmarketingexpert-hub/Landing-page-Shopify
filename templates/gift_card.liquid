{% layout 'theme' %}
<section class="giftcard section">
  <div class="page-wrap page-wrap--narrow">
    <header class="section-head">
      <p class="eyebrow">{{ shop.name }}</p>
      <h1 class="section-head__title">Gift card</h1>
      <p class="muted">{{ gift_card.initial_value | money }} · Expires {% if gift_card.expired %}{{ gift_card.expires_on | date: '%b %d, %Y' }}{% else %}never{% endif %}</p>
    </header>

    <div class="giftcard__card">
      <p class="giftcard__label">Amount</p>
      <p class="giftcard__amount">{{ gift_card.balance | money }}</p>
      <div class="giftcard__code">
        <span class="giftcard__code-val">{{ gift_card.code | format_code }}</span>
        <button type="button" class="btn btn--ghost btn--sm" data-copy="{{ gift_card.code }}">Copy</button>
      </div>
      {%- if gift_card.qr_identifier -%}
        {{ gift_card | qr_code | image_tag: class: 'giftcard__qr' }}
      {%- endif -%}
      <div class="giftcard__actions">
        <a class="btn btn--solid" href="{{ shop.url }}">Shop now</a>
        <a class="btn btn--ghost" href="{{ gift_card.pass_url }}" target="_blank" rel="noopener">Add to Apple Wallet</a>
      </div>
    </div>
  </div>
</section>
