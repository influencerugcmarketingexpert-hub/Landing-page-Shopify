    "brand_story": {
      "type": "brand-story",
      "settings": {
        "eyebrow": "The workshop",
        "heading": "The Orlaven atelier",
        "subheading": "<p>We began Orlaven with one rule: build a jacket that outlives the person who bought it. Every hide is chosen by hand, cut by hand and sewn by hand.</p>",
        "quote": "Every Orlaven jacket is cut, stitched, and finished by one artisan from start to finish.",
        "author": "Leandro Orlaven, founder",
        "layout": "video-left",
        "cta_label": "Read our story",
        "cta_link": "/pages/about"
      }
    },
    "material_guide": {
      "type": "material-guide",
      "settings": {
        "eyebrow": "Materials",
        "heading": "No corners cut.",
        "subheading": "Full-grain hides, solid brass hardware, cotton-silk linings. We choose every component for feel and longevity.",
        "columns_desktop": 3
      },
      "blocks": {
        "mat_bridle": {
          "type": "material",
          "settings": {
            "heading": "Full-grain bridle leather",
            "description": "Aniline-finished, vegetable-tanned bridle hides that patina beautifully with wear. Sourced from a single Tuscan tannery for consistent grain.",
            "link_label": "Learn more",
            "link": "/pages/materials"
          }
        },
        "mat_shearling": {
          "type": "material",
          "settings": {
            "heading": "Merino shearling",
            "description": "Dense Spanish merino shearling, cured for warmth and combed for softness. Natural insulation without synthetic fillers.",
            "link_label": "Learn more",
            "link": "/pages/materials"
          }
        },
        "mat_lambskin": {
          "type": "material",
          "settings": {
            "heading": "Italian lambskin",
            "description": "Butter-soft lambskin from Tuscan tanneries, chosen for its drape, fine grain and supple hand feel.",
            "link_label": "Learn more",
            "link": "/pages/materials"
          }
        }
      },
      "block_order": ["mat_bridle", "mat_shearling", "mat_lambskin"]
    },
