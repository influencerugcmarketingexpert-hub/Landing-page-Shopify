{%- comment -%}
  Customer order detail
  ---------------------
  Detail view for a single order. Line items, fulfillment status,
  shipping + billing addresses, totals. Tracking links when present.
{%- endcomment -%}
<style>
  .order-page { padding: var(--space-10) 0 var(--space-16); }
  .order-page__back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: inherit;
    border-bottom: 1px solid transparent;
    margin-bottom: var(--space-6);
  }
  .order-page__back:hover { border-bottom-color: var(--color-cognac); color: var(--color-cognac); }
  .order-page__header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    border-bottom: 1px solid rgba(15, 15, 15, 0.08);
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-10);
  }
  .order-page__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cognac);
    margin: 0 0 var(--space-2);
  }
  .order-page__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw + 1rem, 2.5rem);
    color: var(--color-espresso);
    margin: 0;
  }
  .order-page__meta {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    margin: var(--space-2) 0 0;
  }
  .order-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
  }
  @media (min-width: 960px) {
    .order-page__grid { grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); }
  }
  .order-table {
    width: 100%;
    border-collapse: collapse;
  }
  .order-table thead th {
    text-align: left;
    padding: var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-espresso);
    border-bottom: 1px solid rgba(15, 15, 15, 0.12);
  }
  .order-table tbody td,
  .order-table tfoot td,
  .order-table tfoot th {
    padding: var(--space-4) var(--space-3);
    border-bottom: 1px solid rgba(15, 15, 15, 0.06);
    font-size: var(--text-sm);
    vertical-align: top;
  }
  .order-table tfoot th {
    text-align: right;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    font-size: var(--text-xs);
    color: var(--color-espresso);
  }
  .order-table tfoot tr.order-total th,
  .order-table tfoot tr.order-total td {
    font-size: var(--text-base);
    font-family: var(--font-heading);
    color: var(--color-espresso);
    border-top: 1px solid rgba(15, 15, 15, 0.12);
  }
  .order-line {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
  }
  .order-line__image {
    width: 72px;
    aspect-ratio: 4 / 5;
    background-color: var(--color-beige);
    flex: 0 0 72px;
    overflow: hidden;
  }
  .order-line__image img { width: 100%; height: 100%; object-fit: cover; }
  .order-line__title {
    display: block;
    font-family: var(--font-heading);
    font-size: var(--text-base);
    color: var(--color-espresso);
    margin-bottom: var(--space-1);
  }
  .order-line__variant {
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--color-text) 65%, transparent);
  }
  .order-fulfillment {
    background-color: var(--color-cream);
    padding: var(--space-5);
    margin-bottom: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .order-fulfillment__label {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cognac);
    margin: 0;
  }
  .order-fulfillment a {
    color: var(--color-espresso);
    border-bottom: 1px solid var(--color-cognac);
    font-size: var(--text-sm);
  }
  .order-addresses {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }
  @media (min-width: 640px) {
    .order-addresses { grid-template-columns: 1fr 1fr; }
  }
  .order-address {
    background-color: var(--color-cream);
    padding: var(--space-5);
  }
  .order-address h3 {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cognac);
    margin: 0 0 var(--space-2);
  }
  .order-address address { font-style: normal; line-height: var(--leading-relaxed); font-size: var(--text-sm); }
  .order-cancelled {
    padding: var(--space-4);
    background-color: #fdecea;
    border-left: 3px solid #b3261e;
    color: #5a1715;
    margin-bottom: var(--space-6);
    font-size: var(--text-sm);
  }
</style>

<section class="order-page" aria-labelledby="OrderTitle">
  <div class="container">
    <a class="order-page__back" href="{{ routes.account_url }}">
      {%- render 'icon-arrow-left', size: 14 -%}
      {{ 'customer.account.return' | t }}
    </a>

    <header class="order-page__header">
      <div>
        <p class="order-page__eyebrow">{{ 'customer.orders.title' | t }}</p>
        <h1 id="OrderTitle" class="order-page__title">
          {{ 'customer.order.title' | t: name: order.name }}
        </h1>
        <p class="order-page__meta">
          {{ 'customer.order.date_html' | t: date: order.created_at | date: format: 'date_at_time' }}
        </p>
      </div>
      <div>
        <span class="order-status order-status--{{ order.financial_status }}"
              style="display:inline-flex; padding:2px 10px; border-radius: var(--radius-full); font-size: var(--text-xs); letter-spacing: var(--tracking-wide); text-transform: uppercase; border: 1px solid currentColor;">
          {{ order.financial_status_label }}
        </span>
      </div>
    </header>

    {%- if order.cancelled -%}
      <div class="order-cancelled" role="status">
        <p style="margin:0;">
          <strong>{{ 'customer.order.cancelled_html' | t: date: order.cancelled_at | date: format: 'date' }}</strong>
        </p>
        {%- if order.cancel_reason_label != blank -%}
          <p style="margin: var(--space-1) 0 0;">
            {{ 'customer.order.cancelled_reason' | t: reason: order.cancel_reason_label }}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if order.fulfillments.size > 0 -%}
      {%- for fulfillment in order.fulfillments -%}
        <div class="order-fulfillment">
          <p class="order-fulfillment__label">
            {{ 'customer.order.fulfilled_at_html' | t: date: fulfillment.created_at | date: format: 'date' }}
          </p>
          {%- if fulfillment.tracking_url -%}
            <a href="{{ fulfillment.tracking_url }}" target="_blank" rel="noopener">
              {{ 'customer.order.track_shipment' | t }}
              {%- if fulfillment.tracking_company %} &mdash; {{ fulfillment.tracking_company }}{%- endif -%}
              {%- if fulfillment.tracking_number %} ({{ fulfillment.tracking_number }}){%- endif -%}
            </a>
          {%- elsif fulfillment.tracking_number -%}
            <p style="margin:0; font-size: var(--text-sm);">
              {{ 'customer.order.tracking_number' | t }}: {{ fulfillment.tracking_number }}
            </p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    {%- endif -%}

    <div class="order-page__grid">
      <div>
        <div style="overflow-x:auto;">
          <table class="order-table" aria-label="{{ 'customer.order.products' | t | default: 'Order products' }}">
            <thead>
              <tr>
                <th scope="col">{{ 'customer.order.product' | t }}</th>
                <th scope="col">{{ 'customer.order.sku' | t }}</th>
                <th scope="col">{{ 'customer.order.quantity' | t }}</th>
                <th scope="col">{{ 'customer.order.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for line_item in order.line_items -%}
                <tr>
                  <td>
                    <div class="order-line">
                      <div class="order-line__image">
                        {%- if line_item.image -%}
                          <img src="{{ line_item.image | image_url: width: 180 }}"
                               alt="{{ line_item.title | escape }}"
                               width="72" height="90" loading="lazy" decoding="async">
                        {%- endif -%}
                      </div>
                      <div>
                        {%- if line_item.url -%}
                          <a class="order-line__title" href="{{ line_item.url }}">{{ line_item.product.title | default: line_item.title }}</a>
                        {%- else -%}
                          <span class="order-line__title">{{ line_item.product.title | default: line_item.title }}</span>
                        {%- endif -%}
                        {%- unless line_item.product.has_only_default_variant -%}
                          <span class="order-line__variant">{{ line_item.variant.title }}</span>
                        {%- endunless -%}
                        {%- if line_item.fulfillment.tracking_url -%}
                          <br>
                          <a href="{{ line_item.fulfillment.tracking_url }}" target="_blank" rel="noopener" style="font-size: var(--text-xs); border-bottom: 1px solid var(--color-cognac);">
                            {{ 'customer.order.track_shipment' | t }}
                          </a>
                        {%- endif -%}
                      </div>
                    </div>
                  </td>
                  <td>{{ line_item.sku | default: '-' }}</td>
                  <td>{{ line_item.quantity }}</td>
                  <td>{{ line_item.final_line_price | money }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
            <tfoot>
              <tr>
                <th colspan="3" scope="row">{{ 'customer.order.subtotal' | t }}</th>
                <td>{{ order.subtotal_price | money }}</td>
              </tr>
              {%- for discount_application in order.cart_level_discount_applications -%}
                <tr>
                  <th colspan="3" scope="row">
                    {{ 'customer.order.discount' | t }}
                    ({{ discount_application.title }})
                  </th>
                  <td>-{{ discount_application.total_allocated_amount | money }}</td>
                </tr>
              {%- endfor -%}
              {%- for shipping_method in order.shipping_methods -%}
                <tr>
                  <th colspan="3" scope="row">{{ 'customer.order.shipping' | t }} ({{ shipping_method.title }})</th>
                  <td>{{ shipping_method.price | money }}</td>
                </tr>
              {%- endfor -%}
              {%- for tax_line in order.tax_lines -%}
                <tr>
                  <th colspan="3" scope="row">{{ 'customer.order.tax' | t }} ({{ tax_line.title }} {{ tax_line.rate | times: 100 }}%)</th>
                  <td>{{ tax_line.price | money }}</td>
                </tr>
              {%- endfor -%}
              {%- if order.total_duties -%}
                <tr>
                  <th colspan="3" scope="row">{{ 'customer.order.total_duties' | t }}</th>
                  <td>{{ order.total_duties | money }}</td>
                </tr>
              {%- endif -%}
              <tr class="order-total">
                <th colspan="3" scope="row">{{ 'customer.order.total' | t }}</th>
                <td>{{ order.total_price | money }}</td>
              </tr>
              {%- if order.total_refunded_amount > 0 -%}
                <tr>
                  <th colspan="3" scope="row">{{ 'customer.order.total_refunded' | t }}</th>
                  <td>-{{ order.total_refunded_amount | money }}</td>
                </tr>
              {%- endif -%}
            </tfoot>
          </table>
        </div>
      </div>

      <aside>
        <div class="order-addresses">
          {%- if order.billing_address -%}
            <div class="order-address">
              <h3>{{ 'customer.order.billing_address' | t }}</h3>
              <p style="margin:0; font-family: var(--font-heading); color: var(--color-espresso);">
                {{ order.billing_address.first_name }} {{ order.billing_address.last_name }}
              </p>
              <address>{{ order.billing_address | format_address }}</address>
            </div>
          {%- endif -%}
          {%- if order.shipping_address -%}
            <div class="order-address">
              <h3>{{ 'customer.order.shipping_address' | t }}</h3>
              <p style="margin:0; font-family: var(--font-heading); color: var(--color-espresso);">
                {{ order.shipping_address.first_name }} {{ order.shipping_address.last_name }}
              </p>
              <address>{{ order.shipping_address | format_address }}</address>
            </div>
          {%- endif -%}
        </div>
      </aside>
    </div>
  </div>
</section>
