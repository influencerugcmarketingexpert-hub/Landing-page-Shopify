{%- comment -%}
  Customer reset password
  -----------------------
  Landed on from the reset-password email link. Two password fields,
  then submit. Uses the `reset_customer_password` form type.
{%- endcomment -%}
<style>
  .customer-page { padding: var(--space-12) 0 var(--space-16); display:flex; justify-content:center; }
  .customer-page__inner { width: 100%; max-width: 480px; display: flex; flex-direction: column; gap: var(--space-6); }
  .customer-page__header { text-align:center; display:flex; flex-direction:column; gap: var(--space-2); }
  .customer-page__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cognac);
    margin: 0;
  }
  .customer-page__title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw + 1rem, 2.5rem);
    color: var(--color-espresso);
    margin: 0;
  }
  .customer-page__subtext {
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    margin: 0;
    font-size: var(--text-sm);
  }
  .customer-form { display:flex; flex-direction: column; gap: var(--space-4); }
  .customer-form__errors {
    padding: var(--space-3) var(--space-4);
    background-color: #fdecea;
    border-left: 3px solid #b3261e;
    color: #5a1715;
    font-size: var(--text-sm);
  }
  .customer-form__errors ul { padding-left: var(--space-5); list-style: disc; margin: var(--space-1) 0 0; }
</style>

<section class="customer-page" aria-labelledby="ResetTitle">
  <div class="container">
    <div class="customer-page__inner">
      <header class="customer-page__header">
        <p class="customer-page__eyebrow">{{ 'general.password.tagline' | t }}</p>
        <h1 id="ResetTitle" class="customer-page__title">{{ 'customer.reset_password.title' | t }}</h1>
        <p class="customer-page__subtext">{{ 'customer.reset_password.subtext' | t: email: email }}</p>
      </header>

      {%- form 'reset_customer_password', novalidate: 'novalidate' -%}
        {%- if form.errors -%}
          <div class="customer-form__errors" role="alert" tabindex="-1" autofocus>
            <strong>{{ 'shopify.errors.form' | t }}</strong>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="customer-form">
          <div class="field">
            <label for="ResetPassword" class="field__label">{{ 'customer.reset_password.password' | t }}</label>
            <input
              type="password"
              name="customer[password]"
              id="ResetPassword"
              autocomplete="new-password"
              minlength="5"
              required
              {% if form.errors contains 'password' %}aria-invalid="true"{% endif %}>
          </div>
          <div class="field">
            <label for="ResetPasswordConfirmation" class="field__label">{{ 'customer.reset_password.password_confirm' | t }}</label>
            <input
              type="password"
              name="customer[password_confirmation]"
              id="ResetPasswordConfirmation"
              autocomplete="new-password"
              minlength="5"
              required
              {% if form.errors contains 'password_confirmation' %}aria-invalid="true"{% endif %}>
          </div>
          <button type="submit" class="btn btn--primary btn--full">
            {{ 'customer.reset_password.submit' | t }}
          </button>
        </div>
      {%- endform -%}
    </div>
  </div>
</section>
