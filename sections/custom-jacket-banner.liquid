<section class="custom-banner section" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }};" aria-label="Custom jackets">
  <div class="page-wrap custom-banner__inner custom-banner__inner--{{ section.settings.layout }}">
    <div class="custom-banner__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400', sizes: '(max-width:900px) 100vw, 50vw', alt: section.settings.heading }}
      {%- endif -%}
    </div>
    <div class="custom-banner__body">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="custom-banner__heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="custom-banner__sub">{{ section.settings.subheading }}</p>{%- endif -%}
      {%- if section.blocks.size > 0 -%}
        <ol class="steps">
          {%- for block in section.blocks -%}
            <li class="steps__item" {{ block.shopify_attributes }}>
              <span class="steps__num">{{ forloop.index }}</span>
              <div>
                <strong>{{ block.settings.title }}</strong>
                {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
      <div class="custom-banner__ctas">
        {%- if section.settings.cta1_text != blank -%}
          <a class="btn btn--solid" href="{{ section.settings.cta1_url }}">{{ section.settings.cta1_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.cta2_url }}">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom jacket banner",
  "class": "section-custom-banner",
  "max_blocks": 4,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#1A1613" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FAF7F2" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "image-right", "label": "Image right" },
      { "value": "image-left",  "label": "Image left" },
      { "value": "full",        "label": "Full-bleed image behind text" }
    ], "default": "image-right" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Made-to-measure" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Design your own jacket" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Choose your leather, lining, fit, and finish — handcrafted to your measurements." },
    { "type": "text", "id": "cta1_text", "label": "CTA 1 text", "default": "Start designing" },
    { "type": "url",  "id": "cta1_url",  "label": "CTA 1 link" },
    { "type": "text", "id": "cta2_text", "label": "CTA 2 text", "default": "How it works" },
    { "type": "url",  "id": "cta2_url",  "label": "CTA 2 link" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Choose your style" },
        { "type": "text", "id": "text",  "label": "Text",  "default": "Biker, Bomber, Aviator, or Cafe Racer." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom jacket banner",
      "blocks": [
        { "type": "step", "settings": { "title": "Pick a style", "text": "Biker, Bomber, Aviator, Cafe Racer." } },
        { "type": "step", "settings": { "title": "Choose your leather", "text": "Lamb, cow, goat, shearling." } },
        { "type": "step", "settings": { "title": "Send your measurements", "text": "Our tailors do the rest." } },
        { "type": "step", "settings": { "title": "Handcrafted in 3 weeks", "text": "Shipped straight to your door." } }
      ]
    }
  ]
}
{% endschema %}
