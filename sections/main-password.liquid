<div class="password__wrap">
  <div class="password__box">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 240 | image_tag: style: 'width:160px;margin-bottom:24px;' }}
    {%- else -%}
      <h1 style="font-family:var(--font-heading);font-size:2.25rem;letter-spacing:.08em;margin:0 0 8px;">{{ shop.name }}</h1>
    {%- endif -%}
    <p class="eyebrow">{{ 'general.password_page.opening_soon' | t }}</p>
    <h2 class="password__heading">{{ section.settings.heading | default: 'Something remarkable is on its way.' }}</h2>
    {%- if section.settings.body != blank -%}<div class="rte">{{ section.settings.body }}</div>{%- endif -%}
    <div class="password__forms">
      {%- form 'customer', class: 'form form--stack' -%}
        <input type="hidden" name="contact[tags]" value="prelaunch">
        <label>Email<input type="email" name="contact[email]" required></label>
        <button type="submit" class="btn btn--solid">Notify me</button>
        {%- if form.posted_successfully? -%}<p class="form__success">{{ 'general.password_page.signup_form_success' | t }}</p>{%- endif -%}
      {%- endform -%}

      <details class="password__password">
        <summary>Enter password</summary>
        {%- form 'storefront_password', class: 'form form--stack' -%}
          <label>{{ 'general.password_page.login_form_password_label' | t }}<input type="password" name="password" required></label>
          <button type="submit" class="btn btn--ghost">{{ 'general.password_page.login_form_submit' | t }}</button>
          {%- if form.errors -%}<p class="form__error">{{ form.errors | default_errors }}</p>{%- endif -%}
        {%- endform -%}
      </details>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something remarkable is on its way." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Join the circle and we'll tell you the moment the atelier opens its doors.</p>" }
  ]
}
{% endschema %}
