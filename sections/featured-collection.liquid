{%- comment -%}
  Featured collection
  -------------------
  Renders a heading + optional subheading + optional view-all link,
  then either a horizontal scroll-snap carousel (default) or a
  responsive grid of product-card snippets from a chosen collection.

  Used twice on the homepage for "New Arrivals" and "Best Sellers".

  Accepts an empty collection (shows placeholders so the theme editor
  still renders a useful preview).
{%- endcomment -%}
{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 8
  if limit < 4
    assign limit = 4
  endif
  assign cols_desktop = section.settings.columns_desktop | default: 4
  if cols_desktop < 2
    assign cols_desktop = 2
  endif
  if cols_desktop > 5
    assign cols_desktop = 5
  endif
  assign cols_mobile = section.settings.columns_mobile | default: 2
  if cols_mobile < 1
    assign cols_mobile = 1
  endif
  if cols_mobile > 2
    assign cols_mobile = 2
  endif
  assign enable_carousel = section.settings.enable_carousel
  assign show_secondary = section.settings.show_secondary_image
  assign image_ratio = section.settings.image_ratio | default: 'portrait'
  assign has_products = false
  if collection != blank and collection.all_products_count > 0
    assign has_products = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .featured-collection {
    padding: var(--spacing-sections, 72px) 0;
  }
  #shopify-section-{{ section.id }} .featured-collection__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  #shopify-section-{{ section.id }} .featured-collection__heading-group {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  #shopify-section-{{ section.id }} .featured-collection__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw + 1rem, 2.5rem);
    line-height: var(--leading-tight);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .featured-collection__subheading {
    font-size: var(--text-md);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .featured-collection__view-all {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  #shopify-section-{{ section.id }} .featured-collection__view-all:hover { color: var(--color-cognac); }

  /* Grid layout */
  #shopify-section-{{ section.id }} .featured-collection__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat({{ cols_mobile }}, minmax(0, 1fr));
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .featured-collection__grid {
      grid-template-columns: repeat({{ cols_desktop }}, minmax(0, 1fr));
    }
  }

  /* Carousel layout */
  #shopify-section-{{ section.id }} product-carousel {
    display: block;
    position: relative;
  }
  #shopify-section-{{ section.id }} .featured-collection__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--space-4)) / {{ cols_mobile }});
    gap: var(--space-4);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding-bottom: var(--space-3);
  }
  #shopify-section-{{ section.id }} .featured-collection__track::-webkit-scrollbar { display: none; }
  #shopify-section-{{ section.id }} .featured-collection__track > * {
    scroll-snap-align: start;
    min-width: 0;
  }
  @media (min-width: 640px) {
    #shopify-section-{{ section.id }} .featured-collection__track {
      grid-auto-columns: calc((100% - var(--space-4) * 2) / 3);
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .featured-collection__track {
      grid-auto-columns: calc((100% - var(--space-4) * ({{ cols_desktop }} - 1)) / {{ cols_desktop }});
    }
  }
  #shopify-section-{{ section.id }} .featured-collection__carousel-controls {
    display: none;
    gap: var(--space-2);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .featured-collection__carousel-controls { display: inline-flex; }
  }
  #shopify-section-{{ section.id }} .featured-collection__arrow {
    width: 40px; height: 40px;
    border-radius: var(--radius-full);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: var(--transition-base);
  }
  #shopify-section-{{ section.id }} .featured-collection__arrow:hover:not([disabled]),
  #shopify-section-{{ section.id }} .featured-collection__arrow:focus-visible {
    background-color: var(--color-ink);
    color: var(--color-cream);
  }
  #shopify-section-{{ section.id }} .featured-collection__arrow[disabled] {
    opacity: 0.35;
    cursor: not-allowed;
  }
  #shopify-section-{{ section.id }} .featured-collection__empty {
    padding: var(--space-10);
    border: 1px dashed color-mix(in oklab, var(--color-text) 20%, transparent);
    text-align: center;
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }
</style>

<section class="featured-collection">
  <div class="container">
    <header class="featured-collection__header">
      <div class="featured-collection__heading-group">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="featured-collection__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      <div class="featured-collection__actions">
        {%- if enable_carousel and has_products -%}
          <div class="featured-collection__carousel-controls" aria-label="{{ 'sections.featured_collection.carousel_controls' | t | default: 'Carousel controls' }}">
            <button type="button" class="featured-collection__arrow" data-carousel-prev
                    aria-label="{{ 'general.accessibility.previous_slide' | t }}">
              {%- render 'icon-arrow-left', size: 16 -%}
            </button>
            <button type="button" class="featured-collection__arrow" data-carousel-next
                    aria-label="{{ 'general.accessibility.next_slide' | t }}">
              {%- render 'icon-arrow-right', size: 16 -%}
            </button>
          </div>
        {%- endif -%}

        {%- if section.settings.show_view_all and collection != blank -%}
          <a class="featured-collection__view-all"
             href="{{ collection.url | default: routes.all_products_collection_url }}">
            {{ section.settings.view_all_text | default: 'sections.featured_collection.view_all' | t }}
            {%- render 'icon-arrow-right', size: 14 -%}
          </a>
        {%- endif -%}
      </div>
    </header>

    {%- if has_products -%}
      {%- if enable_carousel -%}
        <product-carousel data-section-id="{{ section.id }}">
          <ul class="featured-collection__track" role="list" data-carousel-track>
            {%- for product in collection.products limit: limit -%}
              <li>
                {%- render 'product-card',
                    product: product,
                    image_ratio: image_ratio,
                    show_secondary_image: show_secondary,
                    sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'
                -%}
              </li>
            {%- endfor -%}
          </ul>
        </product-carousel>
      {%- else -%}
        <ul class="featured-collection__grid" role="list">
          {%- for product in collection.products limit: limit -%}
            <li>
              {%- render 'product-card',
                  product: product,
                  image_ratio: image_ratio,
                  show_secondary_image: show_secondary,
                  sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'
              -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    {%- else -%}
      <div class="featured-collection__empty" role="status">
        {%- if collection == blank -%}
          {{ 'sections.featured_collection.empty_no_collection' | t | default: 'Select a collection in the theme editor to populate this section.' }}
        {%- else -%}
          {{ 'sections.featured_collection.empty_collection' | t | default: 'This collection has no products yet.' }}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if enable_carousel and has_products -%}
  <script>
    (function () {
      if (customElements.get('product-carousel')) return;
      class ProductCarousel extends HTMLElement {
        connectedCallback() {
          this.track = this.querySelector('[data-carousel-track]');
          if (!this.track) return;
          var host = this.closest('section') || document;
          this.prevBtn = host.querySelector('[data-carousel-prev]');
          this.nextBtn = host.querySelector('[data-carousel-next]');
          var self = this;
          if (this.prevBtn) this.prevBtn.addEventListener('click', function () { self._scroll(-1); });
          if (this.nextBtn) this.nextBtn.addEventListener('click', function () { self._scroll(1); });
          this.track.addEventListener('scroll', function () { self._updateArrows(); }, { passive: true });
          window.addEventListener('resize', function () { self._updateArrows(); });
          this._updateArrows();
        }
        _step() {
          var first = this.track.firstElementChild;
          if (!first) return this.track.clientWidth;
          var style = window.getComputedStyle(this.track);
          var gap = parseFloat(style.columnGap || style.gap || 0) || 0;
          return first.getBoundingClientRect().width + gap;
        }
        _scroll(dir) {
          this.track.scrollBy({ left: this._step() * dir, behavior: 'smooth' });
        }
        _updateArrows() {
          if (!this.prevBtn || !this.nextBtn) return;
          var max = this.track.scrollWidth - this.track.clientWidth - 1;
          if (this.track.scrollLeft <= 1) this.prevBtn.setAttribute('disabled', ''); else this.prevBtn.removeAttribute('disabled');
          if (this.track.scrollLeft >= max) this.nextBtn.setAttribute('disabled', ''); else this.nextBtn.removeAttribute('disabled');
        }
      }
      customElements.define('product-carousel', ProductCarousel);
    }());
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Featured collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Fresh from the atelier this week."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "enable_carousel",
      "label": "Enable carousel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "portrait",  "label": "Portrait (4/5)" },
        { "value": "square",    "label": "Square" },
        { "value": "landscape", "label": "Landscape (3/2)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view-all link",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View-all text",
      "default": "View all"
    }
  ],
  "presets": [
    {
      "name": "Featured collection",
      "category": "Products"
    }
  ]
}
{% endschema %}
