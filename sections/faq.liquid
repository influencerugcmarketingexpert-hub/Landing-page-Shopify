{%- comment -%}
  FAQ
  ---
  Block-driven FAQ. Two block types:
    - faq_group: holds a `heading` and optional intro. Starts a new
      category. Everything until the next faq_group is rendered inside.
    - faq_item:  question + richtext answer. Rendered inside a
      <summary-details> accordion.

  Schema.org FAQPage JSON-LD is emitted once at the top of the
  section so search engines can surface the answers directly.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'single'
  assign block_count = section.blocks.size
  assign has_groups = false
  for b in section.blocks
    if b.type == 'faq_group'
      assign has_groups = true
      break
    endif
  endfor
-%}

<style>
  #shopify-section-{{ section.id }} .faq-section {
    padding: var(--space-12) 0 var(--space-16);
  }
  #shopify-section-{{ section.id }} .faq-section__header {
    max-width: 760px;
    margin: 0 auto var(--space-10);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .faq-section__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--color-cognac);
    margin: 0 0 var(--space-2);
  }
  #shopify-section-{{ section.id }} .faq-section__heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw + 1rem, 3rem);
    line-height: var(--leading-tight);
    color: var(--color-espresso);
    margin: 0 0 var(--space-3);
  }
  #shopify-section-{{ section.id }} .faq-section__subheading {
    color: color-mix(in oklab, var(--color-text) 75%, transparent);
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .faq-section__groups {
    display: grid;
    gap: var(--space-10);
    grid-template-columns: 1fr;
  }
  {% if layout == 'two-col' %}
  @media (min-width: 900px) {
    #shopify-section-{{ section.id }} .faq-section__groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-12);
    }
  }
  {% endif %}
  #shopify-section-{{ section.id }} .faq-group__heading {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    color: var(--color-espresso);
    margin: 0 0 var(--space-3);
  }
  #shopify-section-{{ section.id }} .faq-group__intro {
    color: color-mix(in oklab, var(--color-text) 75%, transparent);
    margin: 0 0 var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }
  #shopify-section-{{ section.id }} summary-details > details {
    border-top: 1px solid rgba(15, 15, 15, 0.1);
    padding: 0;
  }
  #shopify-section-{{ section.id }} summary-details > details:last-of-type {
    border-bottom: 1px solid rgba(15, 15, 15, 0.1);
  }
  #shopify-section-{{ section.id }} summary-details > details > summary {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    color: var(--color-espresso);
    padding: var(--space-4) 0;
  }
  #shopify-section-{{ section.id }} .faq-item__answer {
    padding: 0 0 var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: color-mix(in oklab, var(--color-text) 85%, transparent);
  }
  #shopify-section-{{ section.id }} .faq-item__answer > * + * { margin-top: var(--space-3); }
  #shopify-section-{{ section.id }} .faq-section__empty {
    padding: var(--space-10);
    border: 1px dashed color-mix(in oklab, var(--color-text) 20%, transparent);
    text-align: center;
    color: color-mix(in oklab, var(--color-text) 65%, transparent);
  }
</style>

<section class="faq-section" aria-labelledby="FaqHeading-{{ section.id }}">
  <div class="container">
    <header class="faq-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <p class="faq-section__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h1 id="FaqHeading-{{ section.id }}" class="faq-section__heading">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <div class="faq-section__subheading rte">{{ section.settings.subheading }}</div>
      {%- endif -%}
    </header>

    {%- if block_count == 0 -%}
      <div class="faq-section__empty" role="status">
        {{ 'sections.faq.empty' | t | default: 'Add FAQ groups and items in the theme editor.' }}
      </div>
    {%- else -%}
      <div class="faq-section__groups">
        {%- liquid
          assign group_open = false
        -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'faq_group' -%}
            {%- if group_open -%}
              </summary-details>
              </section>
            {%- endif -%}
            <section class="faq-group" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="faq-group__heading">{{ block.settings.heading }}</h2>
              {%- endif -%}
              {%- if block.settings.intro != blank -%}
                <div class="faq-group__intro rte">{{ block.settings.intro }}</div>
              {%- endif -%}
              <summary-details>
            {%- assign group_open = true -%}
          {%- elsif block.type == 'faq_item' -%}
            {%- unless group_open -%}
              {%- comment -%}
                No group declared. Open a default group so the accordion
                still renders. This also ensures <summary-details> wraps
                every <details>.
              {%- endcomment -%}
              <section class="faq-group">
                <summary-details>
              {%- assign group_open = true -%}
            {%- endunless -%}
            <details {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="faq-item__answer rte">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
        {%- if group_open -%}
          </summary-details>
          </section>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{%- if has_groups or block_count > 0 -%}
  {%- capture faq_ld -%}
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq_item' and block.settings.question != blank -%}
          {%- unless first -%},{%- endunless -%}
          {%- assign first = false -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | json }}
            }
          }
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  {%- endcapture -%}
  <script type="application/ld+json">{{ faq_ld | strip_newlines }}</script>
{%- endif -%}

{% schema %}
{
  "name": "FAQ",
  "tag": "section",
  "class": "section-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Help"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Frequently asked"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Sizing, shipping, returns, after-care. The answers below cover nine out of ten of the questions we receive.</p>"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "single",  "label": "Single column" },
        { "value": "two-col", "label": "Two columns" }
      ],
      "default": "single"
    }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "faq_group",
      "name": "FAQ group",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Group heading",
          "default": "Shipping"
        },
        {
          "type": "richtext",
          "id": "intro",
          "label": "Intro (optional)"
        }
      ]
    },
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "When will my order arrive?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>In-stock jackets ship within two business days. Standard delivery takes 3 to 5 days in the US and EU, 5 to 10 days for the rest of the world.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "category": "Page",
      "blocks": [
        { "type": "faq_group", "settings": { "heading": "Orders & shipping" } },
        { "type": "faq_item",  "settings": { "question": "When will my order arrive?", "answer": "<p>In-stock jackets ship within two business days. Standard delivery takes 3 to 5 days in the US and EU, 5 to 10 days for the rest of the world. You will receive a tracking link by email once your order is dispatched.</p>" } },
        { "type": "faq_item",  "settings": { "question": "Do you ship worldwide?", "answer": "<p>Yes. We ship to every country that our logistics partners serve. Duties and taxes are calculated at checkout for the US, the UK, the EU, Australia and Canada. For other destinations, duties are collected on delivery.</p>" } },
        { "type": "faq_item",  "settings": { "question": "Is shipping free?", "answer": "<p>Yes, on orders over $200 (or the local equivalent). Below that threshold, shipping is calculated at checkout.</p>" } },
        { "type": "faq_group", "settings": { "heading": "Returns & exchanges" } },
        { "type": "faq_item",  "settings": { "question": "What is your return policy?", "answer": "<p>You have 30 days from delivery to return or exchange an unworn jacket. Returns are free within the US and EU. For other regions, you cover the return shipping.</p>" } },
        { "type": "faq_item",  "settings": { "question": "Can I exchange for a different size?", "answer": "<p>Yes. Start an exchange from your account page or email atelier@orlaven.com with your order number and the size you would like.</p>" } },
        { "type": "faq_group", "settings": { "heading": "Fit & sizing" } },
        { "type": "faq_item",  "settings": { "question": "How do Orlaven jackets fit?", "answer": "<p>We cut slim in the shoulder and chest to sit close to the body. If you are between sizes, we recommend sizing up. The full measurement tables are on our <a href=\"/pages/size-guide\">size guide</a> page.</p>" } },
        { "type": "faq_item",  "settings": { "question": "Do you offer alterations?", "answer": "<p>Yes. Every Orlaven order includes a complimentary sleeve or hem alteration within the first 60 days. Contact our atelier and we will walk you through next steps.</p>" } },
        { "type": "faq_group", "settings": { "heading": "Care & repairs" } },
        { "type": "faq_item",  "settings": { "question": "How do I care for my jacket?", "answer": "<p>Wipe with a soft cloth. Condition twice a year with a neutral leather balm. Avoid direct heat and prolonged rain. Detailed care notes are shipped with every jacket.</p>" } },
        { "type": "faq_item",  "settings": { "question": "Do you offer repairs?", "answer": "<p>Yes, for the lifetime of the jacket. Seams, zips, linings, buttons, all included. Send us photos of the damage and we will send a prepaid return label.</p>" } },
        { "type": "faq_group", "settings": { "heading": "Materials & sourcing" } },
        { "type": "faq_item",  "settings": { "question": "Where do you source your leather?", "answer": "<p>Our hides come from LWG-certified tanneries in Tuscany and Piedmont. Every Orlaven jacket carries a certificate of origin listing the tannery and tanning method.</p>" } },
        { "type": "faq_item",  "settings": { "question": "Is Orlaven sustainable?", "answer": "<p>Sustainability for us is durability: a jacket that lasts 30 years beats five that last five. We repair for life and source responsibly. Our <a href=\"/pages/about\">atelier page</a> covers the full picture.</p>" } }
      ]
    }
  ],
  "enabled_on": {
    "templates": ["page"]
  }
}
{% endschema %}
