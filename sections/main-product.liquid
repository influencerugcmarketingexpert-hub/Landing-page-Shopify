{%- comment -%}
  Main product
  ------------
  Full product detail page. Pairs a product-media-gallery with a blocks-driven
  info column (vendor, title, price, variant picker, quantity, buy buttons,
  description, rating, share, collapsible tabs, custom liquid).

  Metafields this section reads (optional; merchants populate in Shopify admin):
    - product.metafields.custom.material        Full-grain hide, etc. (rich text)
    - product.metafields.custom.fit             Fit notes, model wears. (rich text)
    - product.metafields.custom.care            Care instructions. (rich text)
    - variant.metafields.custom.swatch_color    Hex/css-color for swatch dot.

  The section is wrapped in a <product-info> custom element that scopes
  variant-change events and fans them out to the gallery, price, sticky bar
  and form. See assets/product.js for the element definitions.
{%- endcomment -%}

{%- liquid
  assign section_id = section.id
  assign current_variant = product.selected_or_first_available_variant
  assign gallery_layout = section.settings.gallery_layout | default: 'thumbnails-left'
  assign media_size = section.settings.media_size | default: 'medium'
  assign enable_sticky = section.settings.enable_sticky_buy_bar
  assign compare_at = current_variant.compare_at_price
  assign on_sale = false
  if compare_at and compare_at > current_variant.price
    assign on_sale = true
  endif
-%}

<script src="{{ 'product.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section_id }} .main-product {
    padding: var(--space-8) 0 var(--space-12);
  }
  #shopify-section-{{ section_id }} .main-product__wrap {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }
  @media (min-width: 960px) {
    #shopify-section-{{ section_id }} .main-product__wrap {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: var(--space-10);
    }
  }
  #shopify-section-{{ section_id }} .main-product__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    position: relative;
  }
  @media (min-width: 960px) {
    #shopify-section-{{ section_id }} .main-product__info {
      position: sticky;
      top: calc(var(--space-16));
    }
  }
  #shopify-section-{{ section_id }} .product-block { margin: 0; }
  #shopify-section-{{ section_id }} .product-block--vendor {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }
  #shopify-section-{{ section_id }} .product-block--title {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 2.4vw + 1rem, 2.5rem);
    line-height: var(--leading-tight);
    margin: 0;
  }
  #shopify-section-{{ section_id }} .product-block--price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    font-size: var(--text-xl);
  }
  #shopify-section-{{ section_id }} .product-block--price s {
    color: color-mix(in oklab, var(--color-text) 55%, transparent);
    font-size: var(--text-base);
  }
  #shopify-section-{{ section_id }} .product-block--rating {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-text) 75%, transparent);
  }
  #shopify-section-{{ section_id }} .product-block--description {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: color-mix(in oklab, var(--color-text) 85%, transparent);
  }
  #shopify-section-{{ section_id }} .product-block--description p { margin: 0 0 var(--space-3); }
  #shopify-section-{{ section_id }} .product-block--description p:last-child { margin-bottom: 0; }
  #shopify-section-{{ section_id }} .product-block--stock {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }
  #shopify-section-{{ section_id }} .product-block--stock[data-state="out"] {
    color: var(--color-badge-sold-out);
  }
  #shopify-section-{{ section_id }} .product-block--sku {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    color: color-mix(in oklab, var(--color-text) 55%, transparent);
    text-transform: uppercase;
  }
  #shopify-section-{{ section_id }} .product-block--share {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }
  #shopify-section-{{ section_id }} .product-block--share a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  #shopify-section-{{ section_id }} .product-block--share a:hover,
  #shopify-section-{{ section_id }} .product-block--share a:focus-visible {
    border-bottom-color: currentColor;
  }
  #shopify-section-{{ section_id }} .product-tabs {
    display: flex;
    flex-direction: column;
    gap: 0;
    border-top: 1px solid color-mix(in oklab, var(--color-text) 15%, transparent);
  }
  #shopify-section-{{ section_id }} .product-tabs details {
    border-bottom: 1px solid color-mix(in oklab, var(--color-text) 15%, transparent);
  }
  #shopify-section-{{ section_id }} .product-tabs summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    cursor: pointer;
    font-size: var(--text-md);
    font-weight: 500;
    color: var(--color-text);
  }
  #shopify-section-{{ section_id }} .product-tabs summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section_id }} .product-tabs summary::after {
    content: "+";
    font-size: 20px;
    line-height: 1;
    transition: transform var(--duration-fast) var(--ease-out);
  }
  #shopify-section-{{ section_id }} .product-tabs details[open] > summary::after { content: "\2013"; }
  #shopify-section-{{ section_id }} .product-tabs__body {
    padding: 0 0 var(--space-5);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: color-mix(in oklab, var(--color-text) 85%, transparent);
  }
  #shopify-section-{{ section_id }} .product-tabs__body p { margin: 0 0 var(--space-3); }
  #shopify-section-{{ section_id }} .product-tabs__body p:last-child { margin-bottom: 0; }

  /* Sticky mobile buy bar */
  #shopify-section-{{ section_id }} sticky-buy-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    background: var(--color-background);
    border-top: 1px solid color-mix(in oklab, var(--color-text) 15%, transparent);
    box-shadow: 0 -4px 20px rgba(15, 15, 15, 0.08);
    z-index: var(--z-sticky);
    transform: translateY(100%);
    transition: transform var(--duration-base) var(--ease-out);
  }
  #shopify-section-{{ section_id }} sticky-buy-bar[hidden] { display: none; }
  #shopify-section-{{ section_id }} sticky-buy-bar.is-visible { transform: translateY(0); }
  #shopify-section-{{ section_id }} .sticky-buy-bar__thumb {
    flex: 0 0 44px;
    width: 44px;
    height: 44px;
    overflow: hidden;
    background: var(--color-beige);
  }
  #shopify-section-{{ section_id }} .sticky-buy-bar__thumb img {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ section_id }} .sticky-buy-bar__info {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  #shopify-section-{{ section_id }} .sticky-buy-bar__title {
    font-size: var(--text-sm);
    line-height: 1.2;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  #shopify-section-{{ section_id }} .sticky-buy-bar__price {
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }
  #shopify-section-{{ section_id }} .sticky-buy-bar__btn {
    flex: 0 0 auto;
    min-height: 40px;
    padding: 0 var(--space-4);
    white-space: nowrap;
  }
  @media (min-width: 960px) {
    #shopify-section-{{ section_id }} sticky-buy-bar { display: none !important; }
  }
</style>

<section class="main-product">
  <product-info
    class="main-product__inner"
    data-section-id="{{ section_id }}"
    data-product-id="{{ product.id }}"
    data-product-handle="{{ product.handle }}"
  >
    <script type="application/json" data-product-json>
      {{ product | json }}
    </script>

    <div class="container">
      <div class="main-product__wrap">
        <div class="main-product__gallery">
          {%- render 'product-media-gallery',
              product: product,
              section_id: section_id,
              layout: gallery_layout,
              media_size: media_size
          -%}
        </div>

        <div class="main-product__info">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'vendor' -%}
                {%- if product.vendor != blank -%}
                  <p class="product-block product-block--vendor" {{ block.shopify_attributes }}>
                    {{ product.vendor }}
                  </p>
                {%- endif -%}

              {%- when 'title' -%}
                <h1 class="product-block product-block--title" {{ block.shopify_attributes }}>
                  {{ product.title }}
                </h1>

              {%- when 'price' -%}
                <div
                  class="product-block product-block--price"
                  data-variant-price
                  {{ block.shopify_attributes }}
                >
                  <span class="price__current" data-variant-price-current>
                    {{ current_variant.price | money }}
                  </span>
                  <s class="price__compare" data-variant-price-compare {% unless on_sale %}hidden{% endunless %}>
                    {%- if on_sale -%}{{ compare_at | money }}{%- endif -%}
                  </s>
                </div>
                <p
                  class="product-block product-block--stock"
                  data-variant-stock
                  data-state="{% if current_variant.available %}in{% else %}out{% endif %}"
                  data-text-in-stock="{{ 'products.product.inventory_in_stock' | t }}"
                  data-text-out-of-stock="{{ 'products.product.inventory_out_of_stock' | t }}"
                >
                  {%- if current_variant.available -%}
                    {{ 'products.product.inventory_in_stock' | t }}
                  {%- else -%}
                    {{ 'products.product.inventory_out_of_stock' | t }}
                  {%- endif -%}
                </p>

              {%- when 'variant_picker' -%}
                {%- comment -%} Variant picker is rendered inside the product-form block below. {%- endcomment -%}

              {%- when 'quantity_selector' -%}
                {%- comment -%} Quantity is rendered inside the product-form block below. {%- endcomment -%}

              {%- when 'buy_buttons' -%}
                <div class="product-block product-block--buy" {{ block.shopify_attributes }}>
                  {%- render 'product-form',
                      product: product,
                      section_id: section_id,
                      show_dynamic_checkout: block.settings.show_dynamic_checkout
                  -%}
                  {%- if current_variant.sku != blank -%}
                    <p class="product-block product-block--sku" data-variant-sku>
                      {{ 'products.product.sku' | t }}: {{ current_variant.sku }}
                    </p>
                  {%- endif -%}
                </div>

              {%- when 'description' -%}
                {%- if product.description != blank -%}
                  <div class="product-block product-block--description rte" {{ block.shopify_attributes }}>
                    {{ product.description }}
                  </div>
                {%- endif -%}

              {%- when 'rating' -%}
                <div class="product-block product-block--rating" {{ block.shopify_attributes }}>
                  {%- if block.settings.judgeme_mount -%}
                    <div class="jdgm-widget jdgm-preview-badge" data-id="{{ product.id }}"></div>
                  {%- else -%}
                    {%- assign rating = product.metafields.reviews.rating_value | default: 4.8 -%}
                    {%- assign rating_count = product.metafields.reviews.rating_count | default: 0 -%}
                    <span aria-hidden="true">
                      {%- for i in (1..5) -%}
                        {%- if i <= rating -%}
                          {%- render 'icon-star', size: 14 -%}
                        {%- else -%}
                          {%- render 'icon-star-half', size: 14 -%}
                        {%- endif -%}
                      {%- endfor -%}
                    </span>
                    <span>
                      {{ rating }}
                      {%- if rating_count > 0 %} ({{ rating_count }}){%- endif -%}
                    </span>
                  {%- endif -%}
                </div>

              {%- when 'share' -%}
                <div class="product-block product-block--share" {{ block.shopify_attributes }}>
                  <span>{{ 'general.social.share' | t }}:</span>
                  <a
                    href="https://www.facebook.com/sharer/sharer.php?u={{ shop.url }}{{ product.url }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{{ 'general.social.share_on_facebook' | t }}"
                  >Facebook</a>
                  <a
                    href="https://twitter.com/intent/tweet?url={{ shop.url }}{{ product.url }}&text={{ product.title | url_encode }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{{ 'general.social.share_on_twitter' | t }}"
                  >X</a>
                  <a
                    href="https://pinterest.com/pin/create/button/?url={{ shop.url }}{{ product.url }}&media={% if product.featured_image %}https:{{ product.featured_image | image_url: width: 1200 }}{% endif %}&description={{ product.title | url_encode }}"
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label="{{ 'general.social.share_on_pinterest' | t }}"
                  >Pinterest</a>
                </div>

              {%- when 'collapsible_tab' -%}
                {%- if forloop.first or forloop.index == 1 -%}{%- endif -%}
                {%- comment -%}
                  Each collapsible_tab block renders its own <details>.
                  They are styled together by .product-tabs when rendered
                  contiguously in the info column.
                {%- endcomment -%}
                {%- assign tab_icon = block.settings.icon | default: 'default' -%}
                {%- assign tab_heading = block.settings.heading | default: 'Details' -%}
                {%- assign tab_key = tab_heading | handleize -%}
                {%- assign tab_content = block.settings.content -%}
                {%- if tab_content == blank -%}
                  {%- if tab_key == 'description' and product.description != blank -%}
                    {%- assign tab_content = product.description -%}
                  {%- elsif tab_key == 'size-fit' or tab_key == 'size-and-fit' -%}
                    {%- assign tab_content = product.metafields.custom.fit | default: tab_content -%}
                  {%- elsif tab_key == 'care' -%}
                    {%- assign tab_content = product.metafields.custom.care | default: tab_content -%}
                  {%- elsif tab_key == 'materials' or tab_key == 'material' -%}
                    {%- assign tab_content = product.metafields.custom.material | default: tab_content -%}
                  {%- endif -%}
                {%- endif -%}
                <summary-details class="product-tabs product-tabs--single" {{ block.shopify_attributes }}>
                  <details>
                    <summary>
                      <span>{{ tab_heading }}</span>
                    </summary>
                    <div class="product-tabs__body rte">
                      {%- if tab_content != blank -%}
                        {{ tab_content }}
                      {%- else -%}
                        <p>{{ block.settings.placeholder | default: 'Add content for this tab in the theme editor.' }}</p>
                      {%- endif -%}
                    </div>
                  </details>
                </summary-details>

              {%- when 'custom_liquid' -%}
                {%- if block.settings.custom_liquid != blank -%}
                  <div class="product-block product-block--custom" {{ block.shopify_attributes }}>
                    {{ block.settings.custom_liquid }}
                  </div>
                {%- endif -%}
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- if enable_sticky -%}
      <sticky-buy-bar hidden data-observe-target="[data-atc-button]">
        <div class="sticky-buy-bar__thumb" aria-hidden="true">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 120 }}"
              alt=""
              width="60" height="60"
              loading="lazy"
              decoding="async"
            >
          {%- endif -%}
        </div>
        <div class="sticky-buy-bar__info">
          <p class="sticky-buy-bar__title">{{ product.title }}</p>
          <span class="sticky-buy-bar__price" data-sticky-price>{{ current_variant.price | money }}</span>
        </div>
        <button
          type="button"
          class="btn btn--primary sticky-buy-bar__btn"
          data-sticky-atc
          data-text-default="{{ 'products.product.add_to_cart' | t }}"
          data-text-unavailable="{{ 'products.product.sold_out' | t }}"
          {% if current_variant.available == false %}disabled{% endif %}
        >
          {%- if current_variant.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      </sticky-buy-bar>
    {%- endif -%}
  </product-info>
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "class": "section-main-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_sticky_buy_bar",
      "label": "Show sticky buy bar on mobile",
      "default": true
    },
    {
      "type": "select",
      "id": "gallery_layout",
      "label": "Gallery layout",
      "options": [
        { "value": "thumbnails-left",  "label": "Thumbnails on the left" },
        { "value": "thumbnails-below", "label": "Thumbnails below" },
        { "value": "stacked",          "label": "Stacked (scroll)" }
      ],
      "default": "thumbnails-left"
    },
    {
      "type": "select",
      "id": "media_size",
      "label": "Media size",
      "options": [
        { "value": "small",  "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large",  "label": "Large" }
      ],
      "default": "medium"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Rendered inside the Buy buttons block to keep submit flow consistent."
        }
      ]
    },
    {
      "type": "quantity_selector",
      "name": "Quantity",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Rendered inside the Buy buttons block."
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "info": "Shop Pay, Apple Pay, PayPal buttons below the add-to-cart button.",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "judgeme_mount",
          "label": "Mount Judge.me widget",
          "info": "If enabled, renders a Judge.me placeholder div instead of the star badge.",
          "default": false
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": []
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Empty state text",
          "default": "Add content in the theme editor."
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "default",       "label": "None" },
            { "value": "truck",         "label": "Truck" },
            { "value": "returns",       "label": "Returns" },
            { "value": "shield",        "label": "Shield" },
            { "value": "craftsmanship", "label": "Craftsmanship" },
            { "value": "heart",         "label": "Heart" },
            { "value": "star",          "label": "Star" }
          ],
          "default": "default"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Liquid"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product information",
      "category": "Product",
      "blocks": [
        { "type": "vendor" },
        { "type": "title" },
        { "type": "rating" },
        { "type": "price" },
        { "type": "variant_picker" },
        { "type": "quantity_selector" },
        { "type": "buy_buttons" },
        { "type": "description" },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Description",
            "content": "<p>Cut, stitched and finished by one maker in the Orlaven atelier. Full-grain leather, solid brass hardware, cotton-silk lining.</p>",
            "icon": "craftsmanship"
          }
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Size & Fit",
            "content": "<p>Our jackets are cut to a trim, modern fit. Size up if between sizes, or shop our Made-to-Measure service.</p>",
            "icon": "default"
          }
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "content": "<p>Complimentary shipping on orders over $200. Easy 30-day returns on unworn pieces. Made-to-Measure is final sale.</p>",
            "icon": "truck"
          }
        },
        {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "content": "<p>Hang in a dry, ventilated place. Treat once a season with our leather balm. Our atelier offers lifetime repairs - contact us before any intervention.</p>",
            "icon": "heart"
          }
        },
        { "type": "share" }
      ]
    }
  ]
}
{% endschema %}
