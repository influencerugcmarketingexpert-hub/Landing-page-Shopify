{%- comment -%}
  Main collection
  ---------------
  The collection page: optional hero row (collection image + title +
  description), toolbar row (filter button / sort / result count /
  grid-list toggle) and a 2-column layout with sidebar facets + product
  grid. Switches to a single-column layout when filter_type is 'drawer'
  or 'horizontal'.

  Facets are rendered via snippets/facets.liquid and wired up by
  assets/facets.js using the Section Rendering API (?section_id={{ section.id }}).

  Schema settings:
    products_per_page      range 12-48 default 24
    columns_desktop        2-5 default 4
    columns_mobile         1-2 default 2
    enable_filtering       bool default true
    filter_type            select ('drawer','sidebar','horizontal') default 'sidebar'
    enable_sorting         bool default true
    enable_grid_list_toggle bool default true
    image_ratio            portrait/square/landscape
    show_vendor            bool
    show_secondary_image   bool default true
    show_collection_image      bool default true
    show_collection_description bool default true
{%- endcomment -%}
{%- liquid
  assign per_page = section.settings.products_per_page | default: 24
  if per_page < 12
    assign per_page = 12
  endif
  if per_page > 48
    assign per_page = 48
  endif
  assign cols_desktop = section.settings.columns_desktop | default: 4
  if cols_desktop < 2
    assign cols_desktop = 2
  endif
  if cols_desktop > 5
    assign cols_desktop = 5
  endif
  assign cols_mobile = section.settings.columns_mobile | default: 2
  if cols_mobile < 1
    assign cols_mobile = 1
  endif
  if cols_mobile > 2
    assign cols_mobile = 2
  endif
  assign enable_filtering = section.settings.enable_filtering
  assign filter_type = section.settings.filter_type | default: 'sidebar'
  assign enable_sorting = section.settings.enable_sorting
  assign enable_grid_list = section.settings.enable_grid_list_toggle
  assign image_ratio = section.settings.image_ratio | default: 'portrait'
  assign show_vendor = section.settings.show_vendor
  assign show_secondary = section.settings.show_secondary_image
  assign show_collection_image = section.settings.show_collection_image
  assign show_collection_description = section.settings.show_collection_description
  assign layout_two_col = false
  if enable_filtering and filter_type == 'sidebar'
    assign layout_two_col = true
  endif
-%}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} .main-collection {
    padding: var(--space-8) 0 var(--space-12);
  }
  #shopify-section-{{ section.id }} .main-collection__hero {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }
  #shopify-section-{{ section.id }} .main-collection__hero-media {
    width: 100%;
    aspect-ratio: 16 / 6;
    overflow: hidden;
    background-color: var(--color-beige);
  }
  #shopify-section-{{ section.id }} .main-collection__hero-media img,
  #shopify-section-{{ section.id }} .main-collection__hero-media svg.placeholder {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ section.id }} .main-collection__hero-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 68ch;
  }
  #shopify-section-{{ section.id }} .main-collection__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text) 60%, transparent);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .main-collection__title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 3vw + 1rem, 3rem);
    line-height: var(--leading-tight);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .main-collection__description {
    color: color-mix(in oklab, var(--color-text) 75%, transparent);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
  }
  #shopify-section-{{ section.id }} .main-collection__description p { margin: 0 0 var(--space-2); }

  /* Toolbar */
  #shopify-section-{{ section.id }} .collection-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: var(--space-4) 0;
    border-top: 1px solid color-mix(in oklab, var(--color-text) 15%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-text) 15%, transparent);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__left,
  #shopify-section-{{ section.id }} .collection-toolbar__right {
    display: flex; align-items: center; gap: var(--space-3);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__count {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-text) 65%, transparent);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__sort select {
    border: 1px solid currentColor;
    background: transparent;
    color: inherit;
    padding: var(--space-2) var(--space-6) var(--space-2) var(--space-3);
    font: inherit;
    text-transform: uppercase;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
  }
  #shopify-section-{{ section.id }} .collection-toolbar__view {
    display: inline-flex;
    gap: 0;
    border: 1px solid currentColor;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__view button {
    padding: var(--space-2) var(--space-3);
    background: transparent;
    color: inherit;
    border: 0;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__view button + button {
    border-left: 1px solid currentColor;
  }
  #shopify-section-{{ section.id }} .collection-toolbar__view button[aria-pressed="true"] {
    background: var(--color-ink);
    color: var(--color-cream);
  }

  /* Layout */
  #shopify-section-{{ section.id }} .main-collection__layout {
    display: grid;
    gap: var(--space-6);
  }
  {% if layout_two_col %}
    @media (min-width: 1024px) {
      #shopify-section-{{ section.id }} .main-collection__layout {
        grid-template-columns: 260px minmax(0, 1fr);
        gap: var(--space-8);
      }
    }
  {% endif %}

  /* Facets */
  #shopify-section-{{ section.id }} facet-filters-form.facets {
    display: block;
  }
  #shopify-section-{{ section.id }} .facets__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  #shopify-section-{{ section.id }} .facets__heading {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .facets__close {
    display: none;
    background: transparent;
    border: 0;
    color: inherit;
    cursor: pointer;
    padding: var(--space-2);
  }
  #shopify-section-{{ section.id }} .facets__active {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  #shopify-section-{{ section.id }} .facet-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 10px;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
    text-decoration: none;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .facets__clear {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-cognac);
    text-decoration: underline;
  }
  #shopify-section-{{ section.id }} .facets__group {
    border-bottom: 1px solid color-mix(in oklab, var(--color-text) 12%, transparent);
    padding: var(--space-3) 0;
  }
  #shopify-section-{{ section.id }} .facets__group > summary {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    padding: var(--space-2) 0;
  }
  #shopify-section-{{ section.id }} .facets__group > summary::-webkit-details-marker { display: none; }
  #shopify-section-{{ section.id }} .facets__group-body {
    padding-top: var(--space-3);
  }
  #shopify-section-{{ section.id }} .facets__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  #shopify-section-{{ section.id }} .facets__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-sm);
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .facets__label.is-disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  #shopify-section-{{ section.id }} .facets__swatch {
    width: 14px; height: 14px; border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--color-text) 30%, transparent);
    display: inline-block;
  }
  #shopify-section-{{ section.id }} .facets__count {
    color: color-mix(in oklab, var(--color-text) 55%, transparent);
    font-size: var(--text-xs);
  }
  #shopify-section-{{ section.id }} .facets__price-inputs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-3);
  }
  #shopify-section-{{ section.id }} .facets__price-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .facets__price-input {
    padding: var(--space-2) var(--space-3);
    border: 1px solid color-mix(in oklab, var(--color-text) 30%, transparent);
    background: transparent;
    font: inherit;
  }
  #shopify-section-{{ section.id }} .facets__price-note {
    margin-top: var(--space-2);
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--color-text) 55%, transparent);
  }

  /* Facets as drawer (filter_type=drawer) or mobile-always */
  #shopify-section-{{ section.id }} .facets--drawer,
  @media (max-width: 1023px) {
    #shopify-section-{{ section.id }} .facets--sidebar,
    #shopify-section-{{ section.id }} .facets--horizontal {
      position: fixed;
      inset: 0;
      z-index: var(--z-modal);
      background: var(--color-background);
      padding: var(--space-4);
      overflow-y: auto;
      transform: translateX(-100%);
      transition: transform var(--duration-base) var(--ease-out);
    }
    #shopify-section-{{ section.id }} .facets--sidebar.is-open,
    #shopify-section-{{ section.id }} .facets--horizontal.is-open {
      transform: translateX(0);
    }
    #shopify-section-{{ section.id }} .facets__close { display: inline-flex; }
  }

  /* Grid */
  #shopify-section-{{ section.id }} product-grid {
    display: block;
  }
  #shopify-section-{{ section.id }} .product-grid {
    display: grid;
    grid-template-columns: repeat({{ cols_mobile }}, minmax(0, 1fr));
    gap: var(--space-5);
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ cols_desktop | at_most: 3 }}, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ cols_desktop }}, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} product-grid[data-view="list"] .product-grid {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }
  #shopify-section-{{ section.id }} product-grid[data-view="list"] .product-card {
    display: grid;
    grid-template-columns: minmax(140px, 200px) 1fr;
    gap: var(--space-4);
    align-items: start;
  }

  /* Empty state */
  #shopify-section-{{ section.id }} .main-collection__empty {
    padding: var(--space-10);
    text-align: center;
    border: 1px dashed color-mix(in oklab, var(--color-text) 20%, transparent);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }

  #shopify-section-{{ section.id }} .main-collection__pagination {
    display: flex;
    justify-content: center;
    padding: var(--space-8) 0 0;
  }
</style>

<section class="main-collection" data-section-id="{{ section.id }}">
  <div class="container">
    {%- if show_collection_image or show_collection_description -%}
      {%- if collection.image != blank or collection.title != blank or collection.description != blank -%}
        <header class="main-collection__hero">
          {%- if show_collection_image and collection.image != blank -%}
            <div class="main-collection__hero-media">
              {%- render 'responsive-image',
                  image: collection.image,
                  sizes: '100vw',
                  loading: 'eager',
                  fetchpriority: 'high',
                  widths: '600,900,1200,1600,2000',
                  alt: collection.title
              -%}
            </div>
          {%- endif -%}
          <div class="main-collection__hero-body">
            <p class="main-collection__eyebrow">{{ 'sections.collection_template.title' | t | default: 'Collection' }}</p>
            <h1 class="main-collection__title">{{ collection.title | default: 'All products' }}</h1>
            {%- if show_collection_description and collection.description != blank -%}
              <div class="main-collection__description rte">
                {{ collection.description }}
              </div>
            {%- endif -%}
          </div>
        </header>
      {%- endif -%}
    {%- endif -%}

    {%- paginate collection.products by per_page -%}
      <div
        class="collection-toolbar"
        role="region"
        aria-label="{{ 'products.facets.filter_and_sort' | t }}"
      >
        <div class="collection-toolbar__left">
          {%- if enable_filtering and collection.filters.size > 0 -%}
            <button
              type="button"
              class="collection-toolbar__button"
              data-facets-open
              data-section-id="{{ section.id }}"
              aria-controls="FacetFiltersForm-{{ section.id }}"
            >
              {%- render 'icon-menu', size: 14 -%}
              {{ 'products.facets.filter_button' | t }}
            </button>
          {%- endif -%}
          <p class="collection-toolbar__count" data-result-count data-section-id="{{ section.id }}">
            {%- assign total_products = collection.products_count -%}
            {%- if paginate.pages > 1 -%}
              {{ 'products.facets.product_count' | t: product_count: collection.products.size, count: total_products }}
            {%- else -%}
              {{ 'products.facets.product_count_simple' | t: count: total_products }}
            {%- endif -%}
          </p>
          <span class="visually-hidden" aria-live="polite" data-facet-announce data-section-id="{{ section.id }}"></span>
        </div>

        <div class="collection-toolbar__right">
          {%- if enable_grid_list -%}
            <div class="collection-toolbar__view" role="group" aria-label="{{ 'products.facets.filter_and_sort' | t }}">
              <button
                type="button"
                data-view-toggle
                data-view="grid"
                data-section-id="{{ section.id }}"
                aria-pressed="true"
                aria-label="Grid view"
              >
                {%- render 'icon-menu', size: 14 -%}
              </button>
              <button
                type="button"
                data-view-toggle
                data-view="list"
                data-section-id="{{ section.id }}"
                aria-pressed="false"
                aria-label="List view"
              >
                {%- render 'icon-chevron-down', size: 14 -%}
              </button>
            </div>
          {%- endif -%}

          {%- if enable_sorting -%}
            <div class="collection-toolbar__sort">
              <label for="SortBy-{{ section.id }}">
                <span>{{ 'products.facets.sort_by_label' | t }}</span>
                <select
                  id="SortBy-{{ section.id }}"
                  data-sort-select
                  data-section-id="{{ section.id }}"
                  aria-label="{{ 'products.facets.sort_by_label' | t }}"
                >
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}"{% if option.value == collection.sort_by or option.value == collection.default_sort_by %} selected="selected"{% endif %}>
                      {{ option.name }}
                    </option>
                  {%- endfor -%}
                </select>
              </label>
            </div>
          {%- endif -%}
        </div>
      </div>

      <div class="main-collection__layout">
        {%- if enable_filtering and collection.filters.size > 0 -%}
          <aside class="main-collection__facets" aria-label="{{ 'products.facets.filter_and_sort' | t }}">
            {%- render 'facets',
                results: collection,
                section_id: section.id,
                filter_type: filter_type,
                enable_sorting: enable_sorting,
                results_url: collection.url
            -%}
          </aside>
        {%- endif -%}

        <product-grid
          class="main-collection__grid"
          data-product-grid
          data-section-id="{{ section.id }}"
          data-view="grid"
        >
          {%- if collection.products.size > 0 -%}
            <ul class="product-grid" role="list">
              {%- for product in collection.products -%}
                <li>
                  {%- render 'product-card',
                      product: product,
                      show_vendor: show_vendor,
                      image_ratio: image_ratio,
                      show_secondary_image: show_secondary,
                      sizes: '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw'
                  -%}
                </li>
              {%- endfor -%}
            </ul>

            {%- if paginate.pages > 1 -%}
              <div class="main-collection__pagination">
                {%- render 'pagination', paginate: paginate -%}
              </div>
            {%- endif -%}
          {%- else -%}
            <div class="main-collection__empty" role="status">
              <p>{{ 'sections.collection_template.empty' | t }}</p>
              {%- if collection.current_vendor or collection.current_type or collection.all_tags.size > 0 -%}
                <p>{{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url }}</p>
              {%- else -%}
                <p><a class="btn btn--secondary" href="{{ routes.all_products_collection_url }}">{{ 'general.cart.continue_shopping' | t }}</a></p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </product-grid>
      </div>
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "header",
      "content": "Collection hero"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "portrait",  "label": "Portrait (4/5)" },
        { "value": "square",    "label": "Square" },
        { "value": "landscape", "label": "Landscape (3/2)" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": true,
      "info": "Configure filters in Online Store > Navigation > Filters."
    },
    {
      "type": "select",
      "id": "filter_type",
      "label": "Filter layout",
      "options": [
        { "value": "sidebar",    "label": "Sidebar (desktop)" },
        { "value": "drawer",     "label": "Drawer" },
        { "value": "horizontal", "label": "Horizontal" }
      ],
      "default": "sidebar"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_grid_list_toggle",
      "label": "Enable grid / list toggle",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection products",
      "category": "Collection"
    }
  ],
  "enabled_on": {
    "templates": ["collection"]
  }
}
{% endschema %}
