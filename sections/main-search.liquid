{%- comment -%}
  Main search
  -----------
  Search results page. Renders a prominent input bar, the active query,
  a result count and a grid mirroring main-collection. Results can be
  products, articles and pages; each uses a dedicated card.

  Filters + sort are exposed when search.filters is available (Shopify
  supports filtering search.terms against product results).
{%- endcomment -%}
{%- liquid
  assign per_page = section.settings.products_per_page | default: 24
  if per_page < 12
    assign per_page = 12
  endif
  if per_page > 48
    assign per_page = 48
  endif
  assign cols_desktop = section.settings.columns_desktop | default: 4
  if cols_desktop < 2
    assign cols_desktop = 2
  endif
  if cols_desktop > 5
    assign cols_desktop = 5
  endif
  assign cols_mobile = section.settings.columns_mobile | default: 2
  assign enable_filtering = section.settings.enable_filtering
  assign enable_sorting = section.settings.enable_sorting
  assign show_vendor = section.settings.show_vendor
  assign terms = search.terms | default: ''
  assign has_results = false
  if search.performed and search.results_count > 0
    assign has_results = true
  endif
-%}

<script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

<style>
  #shopify-section-{{ section.id }} .main-search {
    padding: var(--space-8) 0 var(--space-12);
  }
  #shopify-section-{{ section.id }} .main-search__header {
    max-width: 800px;
    margin: 0 auto var(--space-8);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .main-search__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text) 60%, transparent);
    margin: 0 0 var(--space-2);
  }
  #shopify-section-{{ section.id }} .main-search__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
    line-height: var(--leading-tight);
    margin: 0 0 var(--space-5);
  }
  #shopify-section-{{ section.id }} .main-search__form {
    display: flex;
    align-items: stretch;
    border-bottom: 2px solid var(--color-text);
    padding-bottom: 4px;
  }
  #shopify-section-{{ section.id }} .main-search__input {
    flex: 1;
    border: 0;
    background: transparent;
    font: inherit;
    font-size: var(--text-lg);
    padding: var(--space-3) 0;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .main-search__input:focus { outline: none; }
  #shopify-section-{{ section.id }} .main-search__submit {
    border: 0;
    background: transparent;
    color: inherit;
    padding: 0 var(--space-3);
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .main-search__meta {
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  #shopify-section-{{ section.id }} .main-search__layout {
    display: grid;
    gap: var(--space-6);
  }
  #shopify-section-{{ section.id }} .main-search__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }
  #shopify-section-{{ section.id }} .main-search__group-heading {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    margin: 0 0 var(--space-4);
  }
  #shopify-section-{{ section.id }} .product-grid,
  #shopify-section-{{ section.id }} .article-grid,
  #shopify-section-{{ section.id }} .page-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat({{ cols_mobile }}, minmax(0, 1fr));
    gap: var(--space-5);
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ cols_desktop | at_most: 3 }}, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .product-grid {
      grid-template-columns: repeat({{ cols_desktop }}, minmax(0, 1fr));
    }
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .article-grid,
    #shopify-section-{{ section.id }} .page-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  #shopify-section-{{ section.id }} .search-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .search-card__media {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-beige);
  }
  #shopify-section-{{ section.id }} .search-card__media img,
  #shopify-section-{{ section.id }} .search-card__media svg.placeholder {
    width: 100%; height: 100%; object-fit: cover; display: block;
  }
  #shopify-section-{{ section.id }} .search-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-lg);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .search-card__excerpt {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }

  #shopify-section-{{ section.id }} .main-search__empty {
    padding: var(--space-12) var(--space-4);
    text-align: center;
    border: 1px dashed color-mix(in oklab, var(--color-text) 20%, transparent);
  }
  #shopify-section-{{ section.id }} .main-search__suggest {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
  }
  #shopify-section-{{ section.id }} .main-search__suggest a {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border: 1px solid currentColor;
    border-radius: var(--radius-full);
    color: inherit;
    text-decoration: none;
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }
  #shopify-section-{{ section.id }} .main-search__suggest a:hover { background: var(--color-ink); color: var(--color-cream); }

  #shopify-section-{{ section.id }} .main-search__pagination {
    display: flex;
    justify-content: center;
    padding: var(--space-8) 0 0;
  }
</style>

<section class="main-search" data-section-id="{{ section.id }}">
  <div class="container">
    <header class="main-search__header">
      <p class="main-search__eyebrow">{{ 'sections.search_template.title' | t | default: 'Search' }}</p>
      {%- if search.performed -%}
        <h1 class="main-search__heading">
          {{ 'general.search.results_with_count' | t: count: search.results_count, terms: terms | escape }}
        </h1>
      {%- else -%}
        <h1 class="main-search__heading">{{ 'general.search.heading' | t | default: 'Search' }}</h1>
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" class="main-search__form" role="search">
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="options[unavailable_products]" value="last">
        <input type="hidden" name="type" value="product,article,page">
        <label for="MainSearchInput" class="visually-hidden">{{ 'general.search.label' | t }}</label>
        <input
          type="search"
          id="MainSearchInput"
          name="q"
          value="{{ terms | escape }}"
          class="main-search__input"
          placeholder="{{ 'general.search.placeholder' | t }}"
          autocomplete="off"
          required
        >
        <button type="submit" class="main-search__submit" aria-label="{{ 'general.search.submit' | t }}">
          {%- render 'icon-search', size: 20 -%}
        </button>
      </form>
    </header>

    {%- if search.performed and search.results_count == 0 -%}
      <div class="main-search__empty" role="status">
        <p>{{ 'sections.search_template.no_results_html' | t: terms: terms | escape }}</p>
        <div class="main-search__suggest">
          {%- assign suggest_handles = section.settings.suggested_collections | default: '' -%}
          {%- if suggest_handles != blank -%}
            {%- assign suggest_list = suggest_handles | split: ',' -%}
            {%- for handle in suggest_list -%}
              {%- assign handle_clean = handle | strip -%}
              {%- assign suggest = collections[handle_clean] -%}
              {%- if suggest != blank -%}
                <a href="{{ suggest.url }}">{{ suggest.title }}</a>
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}">{{ 'general.search.view_all' | t }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- elsif search.performed -%}
      {%- paginate search.results by per_page -%}
        {%- comment -%} Group results by type for legibility. {%- endcomment -%}
        {%- assign product_results = search.results | where: 'object_type', 'product' -%}
        {%- assign article_results = search.results | where: 'object_type', 'article' -%}
        {%- assign page_results = search.results | where: 'object_type', 'page' -%}

        <div class="main-search__groups">
          {%- if product_results.size > 0 -%}
            <div class="main-search__group">
              <h2 class="main-search__group-heading">{{ 'general.search.products' | t }}</h2>
              <ul class="product-grid" role="list">
                {%- for item in product_results -%}
                  <li>
                    {%- render 'product-card',
                        product: item,
                        show_vendor: show_vendor,
                        image_ratio: 'portrait',
                        show_secondary_image: true,
                        sizes: '(min-width: 1024px) 25vw, 50vw'
                    -%}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if article_results.size > 0 -%}
            <div class="main-search__group">
              <h2 class="main-search__group-heading">{{ 'general.search.articles' | t }}</h2>
              <ul class="article-grid" role="list">
                {%- for article in article_results -%}
                  <li>
                    <a class="search-card" href="{{ article.url }}">
                      <div class="search-card__media">
                        {%- if article.image != blank -%}
                          {%- render 'responsive-image', image: article.image, sizes: '33vw', alt: article.title -%}
                        {%- else -%}
                          {%- render 'responsive-image', image: blank, alt: article.title -%}
                        {%- endif -%}
                      </div>
                      <h3 class="search-card__title">{{ article.title }}</h3>
                      {%- if article.excerpt_or_content != blank -%}
                        <p class="search-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if page_results.size > 0 -%}
            <div class="main-search__group">
              <h2 class="main-search__group-heading">{{ 'general.search.pages' | t }}</h2>
              <ul class="page-grid" role="list">
                {%- for page in page_results -%}
                  <li>
                    <a class="search-card" href="{{ page.url }}">
                      <h3 class="search-card__title">{{ page.title }}</h3>
                      {%- if page.content != blank -%}
                        <p class="search-card__excerpt">{{ page.content | strip_html | truncate: 160 }}</p>
                      {%- endif -%}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <div class="main-search__pagination">
            {%- render 'pagination', paginate: paginate -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}
    {%- else -%}
      <div class="main-search__empty" role="status">
        <p>{{ 'general.search.placeholder' | t }}</p>
        <div class="main-search__suggest">
          <a href="{{ routes.all_products_collection_url }}">{{ 'general.search.view_all' | t }}</a>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "class": "section-main-search",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Results per page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    },
    {
      "type": "text",
      "id": "suggested_collections",
      "label": "Suggested collection handles",
      "info": "Comma-separated handles shown when no results are found.",
      "default": "new-arrivals,best-sellers"
    }
  ],
  "presets": [
    {
      "name": "Search results",
      "category": "Search"
    }
  ],
  "enabled_on": {
    "templates": ["search"]
  }
}
{% endschema %}
