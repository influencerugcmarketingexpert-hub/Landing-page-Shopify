<section class="lookbook section" aria-label="Lookbook">
  {%- if section.settings.layout == 'full' -%}
    <div class="lookbook__full">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'lazy', widths: '640,960,1280,1600,2000,2400', sizes: '100vw', alt: section.settings.heading, class: 'lookbook__bg' }}
      {%- endif -%}
      <div class="lookbook__overlay" style="color:{{ section.settings.fg }};">
        <div class="page-wrap lookbook__copy lookbook__copy--{{ section.settings.align_h }}-{{ section.settings.align_v }}">
          {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
          <h2 class="lookbook__heading">{{ section.settings.heading }}</h2>
          {%- if section.settings.pullquote != blank -%}<p class="lookbook__quote">{{ section.settings.pullquote }}</p>{%- endif -%}
          {%- if section.settings.cta_text != blank -%}
            <a class="btn btn--solid" href="{{ section.settings.cta_url }}">{{ section.settings.cta_text }}</a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- else -%}
    <div class="page-wrap lookbook__asym">
      {%- for block in section.blocks -%}
        <figure class="lookbook__tile lookbook__tile--{{ block.settings.size }}" {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '#' }}">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '480,720,960,1200,1400', sizes: '(max-width:900px) 100vw, 50vw', alt: block.settings.caption }}
            {%- endif -%}
            {%- if block.settings.caption != blank -%}
              <figcaption class="lookbook__caption">{{ block.settings.caption }}</figcaption>
            {%- endif -%}
          </a>
        </figure>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lookbook / Editorial",
  "class": "section-lookbook",
  "max_blocks": 6,
  "settings": [
    { "type": "select", "id": "layout", "label": "Layout", "options": [
      { "value": "asym", "label": "Asymmetric tiles" },
      { "value": "full", "label": "Full-bleed editorial" }
    ], "default": "asym" },
    { "type": "header", "content": "Full-bleed mode" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "fg", "label": "Text color", "default": "#FFFFFF" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Autumn editorial" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The quiet authority of leather" },
    { "type": "textarea", "id": "pullquote", "label": "Pull quote" },
    { "type": "select", "id": "align_h", "label": "Horizontal", "options": [
      { "value": "left", "label": "Left" },
      { "value": "center", "label": "Center" },
      { "value": "right", "label": "Right" }
    ], "default": "left" },
    { "type": "select", "id": "align_v", "label": "Vertical", "options": [
      { "value": "top", "label": "Top" },
      { "value": "middle", "label": "Middle" },
      { "value": "bottom", "label": "Bottom" }
    ], "default": "bottom" },
    { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Read the story" },
    { "type": "url",  "id": "cta_url",  "label": "CTA link" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Editorial tile",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "url",  "id": "link", "label": "Link" },
        { "type": "select", "id": "size", "label": "Size", "options": [
          { "value": "wide",   "label": "Wide" },
          { "value": "narrow", "label": "Narrow" }
        ], "default": "wide" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lookbook asymmetric",
      "blocks": [
        { "type": "tile", "settings": { "caption": "The Biker", "size": "wide" } },
        { "type": "tile", "settings": { "caption": "The Cafe Racer", "size": "narrow" } }
      ]
    }
  ]
}
{% endschema %}
