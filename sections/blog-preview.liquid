{%- comment -%}
  Blog preview
  ------------
  Displays the latest 2-6 articles from a selected blog. Each card
  shows the featured image, (optional) tag pill, title, excerpt,
  author, date and a computed read time derived from the article
  content word count (200 wpm, rounded up).

  Desktop: responsive 3-column grid (tunable). Mobile: horizontal
  scroll carousel with snap.
{%- endcomment -%}
{%- liquid
  assign blog = blogs[section.settings.blog]
  assign posts_to_show = section.settings.posts_to_show | default: 3
  if posts_to_show < 2
    assign posts_to_show = 2
  endif
  if posts_to_show > 6
    assign posts_to_show = 6
  endif
  assign show_excerpt = section.settings.show_excerpt
  assign show_author = section.settings.show_author
  assign show_date = section.settings.show_date
  assign cta_label = section.settings.cta_label
  assign cta_link = section.settings.cta_link
  assign has_articles = false
  if blog != blank and blog.articles_count > 0
    assign has_articles = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .blog-preview {
    padding: var(--spacing-sections, 72px) 0;
    background-color: var(--color-background);
    color: var(--color-text);
  }
  #shopify-section-{{ section.id }} .blog-preview__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
    flex-wrap: wrap;
  }
  #shopify-section-{{ section.id }} .blog-preview__titles {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    max-width: 60ch;
  }
  #shopify-section-{{ section.id }} .blog-preview__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text) 60%, transparent);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .blog-preview__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .blog-preview__subheading {
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .blog-preview__cta-top {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  #shopify-section-{{ section.id }} .blog-preview__cta-top:hover { color: var(--color-cognac); border-color: var(--color-cognac); }

  /* Mobile: horizontal scroll */
  #shopify-section-{{ section.id }} .blog-preview__grid {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(85%, 320px);
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 var(--space-4);
    padding-bottom: var(--space-3);
    margin: 0 calc(-1 * var(--gutter, 1rem));
    padding-left: var(--gutter, 1rem);
    padding-right: var(--gutter, 1rem);
  }
  #shopify-section-{{ section.id }} .blog-preview__grid > * {
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    #shopify-section-{{ section.id }} .blog-preview__grid {
      display: grid;
      grid-auto-flow: row;
      grid-template-columns: repeat({{ posts_to_show | at_most: 3 }}, minmax(0, 1fr));
      grid-auto-columns: auto;
      overflow: visible;
      padding: 0;
      margin: 0;
      gap: var(--space-6);
    }
  }
  @media (min-width: 1280px) {
    #shopify-section-{{ section.id }} .blog-preview__grid {
      grid-template-columns: repeat({{ posts_to_show }}, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .article-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .article-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background-color: var(--color-beige);
    border-radius: var(--card-radius, 0);
  }
  #shopify-section-{{ section.id }} .article-card__media img,
  #shopify-section-{{ section.id }} .article-card__media svg.placeholder {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  #shopify-section-{{ section.id }} .article-card:hover .article-card__media img {
    transform: scale(1.04);
  }
  #shopify-section-{{ section.id }} .article-card__tag {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    display: inline-block;
    padding: 4px 10px;
    background-color: var(--color-cream);
    color: var(--color-ink);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    border-radius: var(--radius-full);
  }
  #shopify-section-{{ section.id }} .article-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text) 60%, transparent);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .article-card__meta > span + span::before {
    content: '·';
    margin-right: var(--space-2);
  }
  #shopify-section-{{ section.id }} .article-card__title {
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .article-card__excerpt {
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .article-card__cta {
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
    align-self: flex-start;
    margin-top: var(--space-2);
  }
  #shopify-section-{{ section.id }} .article-card:hover .article-card__cta { color: var(--color-cognac); border-color: var(--color-cognac); }

  #shopify-section-{{ section.id }} .blog-preview__empty {
    text-align: center;
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    padding: var(--space-10) 0;
  }
</style>

<section class="blog-preview" aria-label="{{ section.settings.heading | default: 'Journal' | escape }}">
  <div class="container">

    <header class="blog-preview__header">
      <div class="blog-preview__titles">
        {%- if section.settings.eyebrow != blank -%}
          <p class="blog-preview__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="blog-preview__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="blog-preview__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>

      {%- if cta_label != blank -%}
        {%- assign top_link = cta_link -%}
        {%- if top_link == blank and blog != blank -%}
          {%- assign top_link = blog.url -%}
        {%- endif -%}
        <a class="blog-preview__cta-top" href="{{ top_link | default: '#' }}">
          {{ cta_label }}
        </a>
      {%- endif -%}
    </header>

    {%- if has_articles -%}
      <div class="blog-preview__grid" role="list">
        {%- for article in blog.articles limit: posts_to_show -%}
          {%- liquid
            assign word_count = article.content | strip_html | split: ' ' | size
            assign read_time = word_count | divided_by: 200
            assign remainder = word_count | modulo: 200
            if remainder > 0
              assign read_time = read_time | plus: 1
            endif
            if read_time < 1
              assign read_time = 1
            endif
            assign tag_label = ''
            if article.tags.size > 0
              assign tag_label = article.tags.first
            endif
          -%}
          <a class="article-card" href="{{ article.url }}" role="listitem">
            <div class="article-card__media">
              {%- if article.image != blank -%}
                {%- render 'responsive-image',
                    image: article.image,
                    sizes: '(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 85vw',
                    widths: '300,500,700,900,1100',
                    alt: article.title
                -%}
              {%- else -%}
                {%- render 'responsive-image', image: blank, alt: article.title -%}
              {%- endif -%}
              {%- if tag_label != blank -%}
                <span class="article-card__tag">{{ tag_label }}</span>
              {%- endif -%}
            </div>

            <p class="article-card__meta">
              {%- if show_date and article.published_at != blank -%}
                <span>{{ article.published_at | date: '%b %d, %Y' }}</span>
              {%- endif -%}
              {%- if show_author and article.author != blank -%}
                <span>{{ article.author }}</span>
              {%- endif -%}
              <span>{{ read_time }} min read</span>
            </p>

            <h3 class="article-card__title">{{ article.title }}</h3>

            {%- if show_excerpt and article.excerpt_or_content != blank -%}
              <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p>
            {%- endif -%}

            <span class="article-card__cta">
              {{ 'sections.blog_preview.read_story' | t | default: 'Read story' }}
              {%- render 'icon-arrow-right', size: 14 -%}
            </span>
          </a>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="blog-preview__empty">
        {%- if section.settings.blog == blank -%}
          <p>{{ 'sections.blog_preview.no_blog' | t | default: 'Pick a blog in the theme editor to show your latest stories.' }}</p>
        {%- else -%}
          <p>{{ 'sections.blog_preview.no_articles' | t | default: 'No articles yet. Publish a post in Shopify admin to populate this section.' }}</p>
        {%- endif -%}
        {%- if cta_label != blank and cta_link != blank -%}
          <p style="margin-top: var(--space-4);">
            <a class="btn btn--secondary" href="{{ cta_link }}">{{ cta_label }}</a>
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Blog preview",
  "tag": "section",
  "class": "section-blog-preview",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Stories from the atelier."
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Dispatches, fitting guides and the occasional love letter to good leather."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "label": "Articles to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": false
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Read all stories"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "info": "Leave blank to link to the selected blog."
    }
  ],
  "presets": [
    {
      "name": "Blog preview",
      "category": "Custom"
    }
  ]
}
{% endschema %}
