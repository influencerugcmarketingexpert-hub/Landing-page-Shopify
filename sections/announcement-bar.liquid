<div class="announcement" data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}" style="background:{{ section.settings.bg }};color:{{ section.settings.fg }};">
  <div class="announcement__track" role="region" aria-label="Announcements">
    {%- for block in section.blocks -%}
      <a class="announcement__slide"
         href="{{ block.settings.link | default: '#' }}"
         {% if block.settings.link == blank %}aria-disabled="true" onclick="return false;"{% endif %}
         {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="announcement__icon">{% render 'icon', name: block.settings.icon %}</span>
        {%- endif -%}
        <span class="announcement__text">{{ block.settings.text }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "class": "announcement-section",
  "max_blocks": 6,
  "settings": [
    { "type": "color", "id": "bg", "label": "Background", "default": "#1A1613" },
    { "type": "color", "id": "fg", "label": "Text", "default": "#FAF7F2" },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true },
    { "type": "range", "id": "interval", "label": "Rotate every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 4 }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free worldwide shipping over $250" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "select", "id": "icon", "label": "Icon",
          "options": [
            { "value": "", "label": "None" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "shield", "label": "Shield" },
            { "value": "star", "label": "Star" }
          ], "default": "truck" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [
        { "type": "message", "settings": { "text": "Free worldwide shipping over $250", "icon": "truck" } },
        { "type": "message", "settings": { "text": "30-day easy returns", "icon": "return" } },
        { "type": "message", "settings": { "text": "Handcrafted in full-grain leather", "icon": "shield" } }
      ]
    }
  ]
}
{% endschema %}
