{%- comment -%}
  Collection hero
  ---------------
  Optional banner merchants can place above sections/main-collection.
  Renders a full-bleed image with heading + subheading overlay.

  On a collection template this uses the current `collection` drop for
  heading + description fallbacks. On any other template it uses the
  settings verbatim.
{%- endcomment -%}
{%- liquid
  assign bg_image = section.settings.background_image
  assign overlay = section.settings.overlay_opacity | default: 30
  assign min_height = section.settings.min_height | default: 420
  assign text_pos = section.settings.text_position | default: 'middle-left'
  assign text_color = section.settings.text_color | default: settings.color_cream
  assign heading_text = section.settings.heading
  if heading_text == blank and collection != blank
    assign heading_text = collection.title
  endif
  assign subheading_text = section.settings.subheading
  if subheading_text == blank and collection != blank and collection.description != blank
    assign subheading_text = collection.description | strip_html | truncate: 180
  endif
  if bg_image == blank and collection != blank and collection.image != blank
    assign bg_image = collection.image
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .collection-hero {
    position: relative;
    min-height: {{ min_height }}px;
    display: grid;
    overflow: hidden;
    color: {{ text_color }};
    background: var(--color-beige);
  }
  #shopify-section-{{ section.id }} .collection-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  #shopify-section-{{ section.id }} .collection-hero__media img,
  #shopify-section-{{ section.id }} .collection-hero__media svg.placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .collection-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(15, 15, 15, {{ overlay | divided_by: 100.0 }});
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .collection-hero__inner {
    position: relative;
    z-index: 2;
    display: grid;
    padding: clamp(var(--space-8), 6vw, var(--space-14)) 0;
    width: 100%;
  }
  #shopify-section-{{ section.id }} .collection-hero__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 640px;
  }
  #shopify-section-{{ section.id }} .collection-hero[data-pos="top-left"] .collection-hero__inner      { align-items: start;   justify-items: start;  }
  #shopify-section-{{ section.id }} .collection-hero[data-pos="top-center"] .collection-hero__inner    { align-items: start;   justify-items: center; text-align: center; }
  #shopify-section-{{ section.id }} .collection-hero[data-pos="middle-left"] .collection-hero__inner   { align-items: center; justify-items: start;  }
  #shopify-section-{{ section.id }} .collection-hero[data-pos="center"] .collection-hero__inner        { align-items: center; justify-items: center; text-align: center; }
  #shopify-section-{{ section.id }} .collection-hero[data-pos="bottom-left"] .collection-hero__inner   { align-items: end;    justify-items: start;  }
  #shopify-section-{{ section.id }} .collection-hero[data-pos="bottom-center"] .collection-hero__inner { align-items: end;    justify-items: center; text-align: center; }
  #shopify-section-{{ section.id }} .collection-hero__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    margin: 0;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .collection-hero__heading {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw + 1rem, 3.75rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .collection-hero__subheading {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 52ch;
    opacity: 0.92;
  }
</style>

<section class="collection-hero" data-pos="{{ text_pos }}">
  <div class="collection-hero__media" aria-hidden="true">
    {%- if bg_image != blank -%}
      {%- render 'responsive-image',
          image: bg_image,
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          widths: '600,900,1200,1600,2000,2400',
          alt: heading_text
      -%}
    {%- else -%}
      {%- render 'responsive-image', image: blank, alt: '' -%}
    {%- endif -%}
  </div>

  {%- if overlay > 0 and bg_image != blank -%}
    <div class="collection-hero__overlay" aria-hidden="true"></div>
  {%- endif -%}

  <div class="collection-hero__inner container">
    <div class="collection-hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="collection-hero__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      {%- if heading_text != blank -%}
        <h1 class="collection-hero__heading">{{ heading_text }}</h1>
      {%- endif -%}
      {%- if subheading_text != blank -%}
        <p class="collection-hero__subheading">{{ subheading_text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "class": "section-collection-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading override",
      "info": "Leave blank to use the collection title."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading override",
      "info": "Leave blank to use the collection description."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Falls back to the collection image."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "top-left",      "label": "Top left" },
        { "value": "top-center",    "label": "Top center" },
        { "value": "middle-left",   "label": "Middle left" },
        { "value": "center",        "label": "Center" },
        { "value": "bottom-left",   "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "middle-left"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Minimum height",
      "min": 240,
      "max": 720,
      "step": 20,
      "unit": "px",
      "default": 420
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#F5EFE6"
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "category": "Banners"
    }
  ],
  "enabled_on": {
    "templates": ["collection", "search"]
  }
}
{% endschema %}
