{%- comment -%}
  Brand story
  -----------
  Two-column layout with a deferred video on one side and editorial
  copy on the other. Video may be a YouTube, Vimeo or raw mp4 URL.
  Uses the <deferred-media> custom element from assets/global.js so
  the iframe only mounts on user action.
{%- endcomment -%}
{%- liquid
  assign layout = section.settings.layout | default: 'video-left'
  assign url = section.settings.video_url
  assign cover = section.settings.cover_image
-%}

<style>
  #shopify-section-{{ section.id }} .brand-story {
    padding: var(--spacing-sections, 72px) 0;
  }
  #shopify-section-{{ section.id }} .brand-story__grid {
    display: grid;
    gap: var(--space-8);
    grid-template-columns: 1fr;
    align-items: center;
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .brand-story__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-12);
    }
    #shopify-section-{{ section.id }} .brand-story--right .brand-story__media { order: 2; }
    #shopify-section-{{ section.id }} .brand-story--right .brand-story__body  { order: 1; }
  }
  #shopify-section-{{ section.id }} .brand-story__media {
    position: relative;
    overflow: hidden;
    border-radius: var(--card-radius, 0);
    aspect-ratio: 4 / 5;
    background-color: var(--color-beige);
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .brand-story__media { aspect-ratio: 5 / 6; }
  }
  #shopify-section-{{ section.id }} .brand-story__poster {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
  }
  #shopify-section-{{ section.id }} .brand-story__play {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background: rgba(15, 15, 15, 0.2);
    border: 0;
    color: var(--color-cream);
    cursor: pointer;
    transition: background-color var(--duration-base) var(--ease-out);
  }
  #shopify-section-{{ section.id }} .brand-story__play:hover,
  #shopify-section-{{ section.id }} .brand-story__play:focus-visible {
    background: rgba(15, 15, 15, 0.35);
  }
  #shopify-section-{{ section.id }} .brand-story__play-ring {
    width: 72px; height: 72px;
    border-radius: var(--radius-full);
    background-color: rgba(245, 239, 230, 0.15);
    border: 1px solid var(--color-cream);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .brand-story__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }
  #shopify-section-{{ section.id }} .brand-story__eyebrow {
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: color-mix(in oklab, var(--color-text) 60%, transparent);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .brand-story__heading {
    font-family: var(--font-heading);
    font-size: clamp(1.875rem, 3vw + 1rem, 3rem);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-snug);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .brand-story__subheading {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: color-mix(in oklab, var(--color-text) 80%, transparent);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .brand-story__quote {
    font-family: var(--font-heading);
    font-style: italic;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
    border-left: 2px solid var(--color-cognac);
    padding-left: var(--space-4);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .brand-story__author {
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    margin: 0;
    letter-spacing: var(--tracking-wide);
  }
  #shopify-section-{{ section.id }} .brand-story iframe,
  #shopify-section-{{ section.id }} .brand-story video {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    border: 0;
  }
</style>

<section class="brand-story">
  <div class="container">
    <div class="brand-story__grid{% if layout == 'video-right' %} brand-story--right{% endif %}">
      <deferred-media class="brand-story__media" data-auto-load="false">
        {%- if cover != blank -%}
          <img class="brand-story__poster deferred-media__poster-image"
               src="{{ cover | image_url: width: 1200 }}"
               srcset="{{ cover | image_url: width: 600 }} 600w,
                       {{ cover | image_url: width: 900 }} 900w,
                       {{ cover | image_url: width: 1200 }} 1200w,
                       {{ cover | image_url: width: 1600 }} 1600w"
               sizes="(min-width: 1024px) 50vw, 100vw"
               alt="{{ section.settings.heading | default: 'Brand story' | escape }}"
               loading="lazy" decoding="async"
               width="{{ cover.width }}" height="{{ cover.height }}">
        {%- else -%}
          {%- render 'responsive-image', image: blank, class: 'brand-story__poster', alt: section.settings.heading | default: 'Brand story' -%}
        {%- endif -%}
        {%- if url != blank -%}
          <button type="button"
                  class="brand-story__play deferred-media__poster"
                  data-deferred-media-trigger
                  aria-label="{{ 'products.product.media.play_video' | t | default: 'Play video' }}">
            <span class="brand-story__play-ring">
              {%- render 'icon-play', size: 22 -%}
            </span>
          </button>
          <template>
            {%- if url.type == 'youtube' -%}
              <iframe src="https://www.youtube.com/embed/{{ url.id }}?autoplay=1&rel=0&playsinline=1"
                      title="{{ section.settings.heading | default: 'Brand story' | escape }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"></iframe>
            {%- elsif url.type == 'vimeo' -%}
              <iframe src="https://player.vimeo.com/video/{{ url.id }}?autoplay=1&playsinline=1"
                      title="{{ section.settings.heading | default: 'Brand story' | escape }}"
                      allow="autoplay; encrypted-media"
                      allowfullscreen
                      loading="lazy"></iframe>
            {%- else -%}
              <video autoplay muted loop playsinline controls preload="metadata">
                <source src="{{ url }}" type="video/mp4">
              </video>
            {%- endif -%}
          </template>
        {%- endif -%}
      </deferred-media>

      <div class="brand-story__body">
        {%- if section.settings.eyebrow != blank -%}
          <p class="brand-story__eyebrow">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="brand-story__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <div class="brand-story__subheading rte">{{ section.settings.subheading }}</div>
        {%- endif -%}
        {%- if section.settings.quote != blank -%}
          <blockquote class="brand-story__quote">
            <p>&ldquo;{{ section.settings.quote }}&rdquo;</p>
            {%- if section.settings.author != blank -%}
              <p class="brand-story__author">&mdash; {{ section.settings.author }}</p>
            {%- endif -%}
          </blockquote>
        {%- endif -%}
        {%- if section.settings.cta_label != blank -%}
          <a class="btn btn--secondary"
             href="{{ section.settings.cta_link | default: '#' }}"
             style="align-self: flex-start;">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Brand story",
  "tag": "section",
  "class": "section-brand-story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The workshop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our story."
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>We began Orlaven with one rule: build a jacket that outlives the person who bought it. Every hide is chosen by hand, cut by hand and sewn by hand.</p>"
    },
    {
      "type": "text",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "text",
      "id": "author",
      "label": "Quote author"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"]
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        { "value": "video-left",  "label": "Video left" },
        { "value": "video-right", "label": "Video right" }
      ],
      "default": "video-left"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Read the story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "presets": [
    {
      "name": "Brand story",
      "category": "Custom"
    }
  ]
}
{% endschema %}
