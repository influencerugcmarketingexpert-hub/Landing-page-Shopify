{%- comment -%}
  Instagram feed
  --------------
  Static grid of up to 12 image tiles (blocks type 'post') each with
  an image, caption and outbound link. Includes a
  `<div data-instafeed data-handle="{{ handle }}">` wrapper so the
  Instafeed Shopify app (or any hydration script) can replace the
  static fallback tiles with a live feed.

  Merchants who have Instafeed installed: enable 'Mount Instafeed
  wrapper' and the app will pick up data-instafeed automatically.
{%- endcomment -%}
{%- liquid
  assign block_count = section.blocks.size
  assign handle = section.settings.handle | default: 'orlaven' | strip
  assign cols_desktop = section.settings.columns_desktop | default: 4
  if cols_desktop < 3
    assign cols_desktop = 3
  endif
  if cols_desktop > 6
    assign cols_desktop = 6
  endif
  assign cols_mobile = section.settings.columns_mobile | default: 2
  if cols_mobile < 2
    assign cols_mobile = 2
  endif
  if cols_mobile > 3
    assign cols_mobile = 3
  endif
  assign mount_instafeed = section.settings.enable_instafeed_mount
  assign profile_url = 'https://instagram.com/' | append: handle
-%}

<style>
  #shopify-section-{{ section.id }} .insta-feed {
    padding: var(--spacing-sections, 72px) 0;
    background-color: var(--color-background);
    color: var(--color-text);
  }
  #shopify-section-{{ section.id }} .insta-feed__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }
  #shopify-section-{{ section.id }} .insta-feed__handle {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 2.5vw + 1rem, 2.25rem);
    line-height: var(--leading-tight);
    margin: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .insta-feed__handle:hover { color: var(--color-cognac); }
  #shopify-section-{{ section.id }} .insta-feed__handle svg { width: 28px; height: 28px; }
  #shopify-section-{{ section.id }} .insta-feed__subheading {
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
    font-size: var(--text-sm);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .insta-feed__grid {
    display: grid;
    gap: var(--space-2);
    grid-template-columns: repeat({{ cols_mobile }}, minmax(0, 1fr));
  }
  @media (min-width: 1024px) {
    #shopify-section-{{ section.id }} .insta-feed__grid {
      grid-template-columns: repeat({{ cols_desktop }}, minmax(0, 1fr));
      gap: var(--space-3);
    }
  }
  #shopify-section-{{ section.id }} .insta-tile {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background-color: var(--color-beige);
    color: var(--color-cream);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .insta-tile img,
  #shopify-section-{{ section.id }} .insta-tile svg.placeholder {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform var(--duration-slow) var(--ease-out);
  }
  #shopify-section-{{ section.id }} .insta-tile:hover img {
    transform: scale(1.05);
  }
  #shopify-section-{{ section.id }} .insta-tile__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-3);
    background-color: rgba(15, 15, 15, 0.55);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .insta-tile:hover .insta-tile__overlay,
  #shopify-section-{{ section.id }} .insta-tile:focus-visible .insta-tile__overlay {
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .insta-tile__icon {
    display: inline-flex;
    width: 32px;
    height: 32px;
    color: var(--color-cream);
  }
  #shopify-section-{{ section.id }} .insta-tile__icon svg { width: 100%; height: 100%; }
  #shopify-section-{{ section.id }} .insta-tile__caption {
    font-size: var(--text-xs);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-wide);
    color: var(--color-cream);
    margin: 0;
    max-width: 24ch;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .insta-feed__empty {
    text-align: center;
    color: color-mix(in oklab, var(--color-text) 70%, transparent);
  }
</style>

<section class="insta-feed" aria-label="{{ section.settings.heading | default: 'Instagram' | escape }}">
  <div class="container">

    <header class="insta-feed__header">
      {%- assign heading_text = section.settings.heading | default: '@orlaven' -%}
      <a class="insta-feed__handle" href="{{ profile_url }}" target="_blank" rel="noopener">
        {%- render 'icon-instagram', size: 28 -%}
        <span>{{ heading_text }}</span>
      </a>
      {%- if section.settings.subheading != blank -%}
        <p class="insta-feed__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}
    </header>

    <div data-instafeed data-handle="{{ handle | escape }}"{% unless mount_instafeed %} data-instafeed-fallback="true"{% endunless %}>
      {%- if block_count > 0 -%}
        <ul class="insta-feed__grid" role="list">
          {%- for block in section.blocks -%}
            {%- assign tile_link = block.settings.link | default: profile_url -%}
            <li {{ block.shopify_attributes }}>
              <a class="insta-tile"
                 href="{{ tile_link }}"
                 target="_blank"
                 rel="noopener"
                 aria-label="{{ block.settings.caption | default: heading_text | escape }}">
                {%- if block.settings.image != blank -%}
                  {%- render 'responsive-image',
                      image: block.settings.image,
                      sizes: '(min-width: 1024px) 20vw, 50vw',
                      widths: '200,300,400,600,800',
                      alt: block.settings.caption | default: heading_text
                  -%}
                {%- else -%}
                  {%- render 'responsive-image', image: blank, alt: heading_text -%}
                {%- endif -%}
                <div class="insta-tile__overlay">
                  <span class="insta-tile__icon" aria-hidden="true">{%- render 'icon-instagram', size: 32 -%}</span>
                  {%- if block.settings.caption != blank -%}
                    <p class="insta-tile__caption">{{ block.settings.caption }}</p>
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="insta-feed__empty">
          {{ 'sections.instagram_feed.empty' | t | default: 'Add Instagram post tiles in the theme editor, or connect the Instafeed app to show a live feed.' }}
        </p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Instagram feed",
  "tag": "section",
  "class": "section-instagram-feed",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@orlaven"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Follow along from the workshop."
    },
    {
      "type": "text",
      "id": "handle",
      "label": "Instagram handle (without @)",
      "default": "orlaven"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "min": 2,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "App integration"
    },
    {
      "type": "paragraph",
      "content": "This section renders static image tiles you configure below. If you have the Instafeed Shopify app (or a similar script) installed, enable the option below. The app will replace the static tiles with a live feed by hydrating `div[data-instafeed]`."
    },
    {
      "type": "checkbox",
      "id": "enable_instafeed_mount",
      "label": "Mount Instafeed wrapper (live feed)",
      "default": false
    }
  ],
  "max_blocks": 12,
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link to post"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram feed",
      "category": "Custom",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
