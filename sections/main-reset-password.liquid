<section class="auth section">
  <div class="page-wrap page-wrap--narrow auth__inner">
    <header class="section-head">
      <h1 class="section-head__title">Reset password</h1>
    </header>
    {%- form 'reset_customer_password', class: 'form form--stack' -%}
      {%- if form.errors -%}<div class="form__error">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label>New password<input type="password" name="customer[password]" required></label>
      <label>Confirm new password<input type="password" name="customer[password_confirmation]" required></label>
      <button type="submit" class="btn btn--solid btn--block">Reset</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{ "name": "Reset password", "settings": [] }
{% endschema %}
