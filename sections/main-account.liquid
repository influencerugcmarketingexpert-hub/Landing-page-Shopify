<section class="account section">
  <div class="page-wrap">
    <header class="section-head section-head--row">
      <h1 class="section-head__title">{{ 'customer.account.title' | t }}</h1>
      <a class="btn btn--ghost" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
    </header>

    <div class="account__grid">
      <aside class="account__side">
        <p class="account__name">{{ customer.name }}</p>
        <p class="account__email">{{ customer.email }}</p>
        <ul class="account__nav">
          <li><a href="{{ routes.account_url }}">{{ 'customer.account.details' | t }}</a></li>
          <li><a href="{{ routes.account_addresses_url }}">{{ 'customer.account.addresses' | t }}</a></li>
        </ul>
      </aside>

      <div class="account__main">
        <h2>{{ 'customer.orders.title' | t }}</h2>
        {%- if customer.orders.size > 0 -%}
          <table class="orders">
            <thead><tr>
              <th>{{ 'customer.orders.order_number' | t: number: '' }}</th>
              <th>{{ 'customer.orders.date' | t }}</th>
              <th>{{ 'customer.orders.total' | t }}</th>
              <th>{{ 'customer.orders.status' | t }}</th>
              <th></th>
            </tr></thead>
            <tbody>
              {%- for order in customer.orders -%}
                <tr>
                  <td>{{ order.name }}</td>
                  <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
                  <td>{{ order.total_price | money }}</td>
                  <td>{{ order.financial_status_label }} · {{ order.fulfillment_status_label }}</td>
                  <td><a href="{{ order.customer_url }}" class="btn btn--ghost btn--sm">{{ 'customer.orders.view' | t }}</a></td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- else -%}
          <p>{{ 'customer.orders.none' | t }}</p>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{ "name": "Account", "settings": [] }
{% endschema %}
