<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="no-js">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} — {{ 'general.password_page.opening_soon' | t }}</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {{ content_for_header }}

    {%- assign body_font = settings.type_body -%}
    {%- assign heading_font = settings.type_heading -%}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ heading_font | font_face: font_display: 'swap' }}
      :root {
        --color-bg: {{ settings.color_bg }};
        --color-surface: {{ settings.color_surface }};
        --color-ink: {{ settings.color_ink }};
        --color-muted: {{ settings.color_muted }};
        --color-accent: {{ settings.color_accent }};
        --color-border: {{ settings.color_border }};
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --font-heading: {{ heading_font.family }}, {{ heading_font.fallback_families }};
        --radius: {{ settings.corner_radius }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main class="password-main">
      {{ content_for_layout }}
    </main>
    <footer class="password-foot">
      <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
    </footer>
  </body>
</html>
