<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_espresso | default: '#2B1F17' }}">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; {{ 'general.password.opening_soon' | t }}</title>
    <meta name="description" content="{{ shop.description | default: shop.name | escape }}">

    {%- if settings.social_sharing_image -%}
      <meta property="og:image" content="{{ settings.social_sharing_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta property="og:site_name" content="{{ settings.organization_name | default: shop.name }}">
    <meta property="og:title" content="{{ shop.name | escape }} &mdash; {{ 'general.password.opening_soon' | t }}">
    <meta property="og:type" content="website">
    <meta property="og:description" content="{{ shop.description | default: shop.name | escape }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap">

    {%- assign type_header_font = settings.type_header_font -%}
    {%- assign type_body_font = settings.type_body_font -%}

    {{ type_header_font | font_face: font_display: 'swap' }}
    {{ type_body_font | font_face: font_display: 'swap' }}

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-espresso: {{ settings.color_espresso | default: '#2B1F17' }};
        --color-cognac: {{ settings.color_cognac | default: '#9A5A3C' }};
        --color-cream: {{ settings.color_cream | default: '#F5EFE6' }};
        --color-ink: {{ settings.color_ink | default: '#0F0F0F' }};
        --color-beige: {{ settings.color_beige | default: '#E8DFD2' }};
        --color-background: {{ settings.color_background | default: '#FFFFFF' }};
        --color-text: {{ settings.color_text | default: '#0F0F0F' }};
        --color-accent: {{ settings.color_accent | default: '#9A5A3C' }};
        --color-button: {{ settings.color_button | default: '#2B1F17' }};
        --color-button-text: {{ settings.color_button_text | default: '#F5EFE6' }};
        --font-heading: {{ type_header_font.family }}, {{ type_header_font.fallback_families }};
        --font-heading-weight: {{ type_header_font.weight }};
        --font-body: {{ type_body_font.family }}, {{ type_body_font.fallback_families }};
        --font-body-weight: {{ type_body_font.weight }};
        --page-width: {{ settings.page_width | default: 1440 }}px;
        --button-radius: {{ settings.button_radius | default: 0 }}px;
      }

      body.template-password {
        background: var(--color-espresso);
        color: var(--color-cream);
        font-family: var(--font-body);
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
        margin: 0;
        position: relative;
        isolation: isolate;
      }

      .password-bg {
        position: fixed;
        inset: 0;
        z-index: -1;
        overflow: hidden;
      }

      .password-bg img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0.6;
      }

      .password-bg::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(43, 31, 23, 0.55), rgba(43, 31, 23, 0.85));
      }

      .password-admin-link {
        position: absolute;
        top: 1rem;
        right: 1rem;
        font-size: var(--text-xs);
        letter-spacing: var(--tracking-widest);
        text-transform: uppercase;
        color: var(--color-cream);
        opacity: 0.7;
        z-index: 3;
      }
      .password-admin-link:hover { opacity: 1; color: var(--color-cream); }
      .password-admin-link a { color: inherit; border-bottom: 1px solid rgba(245, 239, 230, 0.4); }

      .password-main {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 4rem 1rem 3rem;
        position: relative;
        z-index: 1;
      }

      .password-wrapper {
        max-width: 560px;
        width: 100%;
        text-align: center;
      }

      .password-logo {
        margin: 0 0 2.5rem;
        font-family: var(--font-heading);
        font-size: clamp(1.75rem, 3vw + 1rem, 2.5rem);
        letter-spacing: 0.2em;
        text-transform: uppercase;
        font-weight: 500;
      }

      .password-logo img {
        max-width: 200px;
        height: auto;
        margin: 0 auto;
        filter: brightness(0) invert(1);
      }

      .password-eyebrow {
        font-size: var(--text-xs);
        letter-spacing: 0.3em;
        text-transform: uppercase;
        color: var(--color-cream);
        opacity: 0.7;
        margin: 0 0 1rem;
      }

      .password-heading {
        font-family: var(--font-heading);
        font-size: clamp(2.5rem, 5vw, 3.75rem);
        font-weight: 500;
        line-height: 1.05;
        margin: 0 0 1rem;
      }

      .password-tagline {
        font-size: var(--text-md);
        line-height: 1.6;
        margin: 0 auto 2.5rem;
        opacity: 0.85;
        max-width: 440px;
      }

      .password-form-card {
        max-width: 420px;
        margin: 0 auto;
        padding: 2rem;
        background-color: rgba(15, 15, 15, 0.35);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(245, 239, 230, 0.12);
      }

      .password-form-card + .password-form-card { margin-top: 1.5rem; }

      .password-form-heading {
        font-family: var(--font-heading);
        font-size: var(--text-xl);
        margin: 0 0 0.25rem;
        color: var(--color-cream);
      }

      .password-form-subheading {
        font-size: var(--text-sm);
        opacity: 0.8;
        margin: 0 0 1.25rem;
      }

      .password-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
      }

      .password-form__group {
        display: flex;
        gap: 0;
      }

      .password-form input[type="email"],
      .password-form input[type="password"],
      .password-form input[type="text"] {
        flex: 1;
        background: transparent;
        border: 1px solid var(--color-cream);
        color: var(--color-cream);
        padding: 0.9rem 1rem;
        font: inherit;
        font-size: var(--text-sm);
        letter-spacing: 0.04em;
        min-height: 48px;
        border-right-width: 0;
      }

      .password-form input:focus-visible {
        outline: 2px solid var(--color-cream);
        outline-offset: 2px;
      }

      .password-form input::placeholder {
        color: var(--color-cream);
        opacity: 0.55;
      }

      .password-form button[type="submit"] {
        background: var(--color-cream);
        color: var(--color-espresso);
        border: 1px solid var(--color-cream);
        padding: 0.9rem 1.5rem;
        font: inherit;
        font-size: var(--text-xs);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        cursor: pointer;
        transition: background-color 200ms ease, color 200ms ease;
        min-height: 48px;
      }

      .password-form button[type="submit"]:hover {
        background: var(--color-cognac);
        border-color: var(--color-cognac);
        color: var(--color-cream);
      }

      .password-show-toggle {
        position: absolute;
        right: 2rem + 4.5rem;
        top: 50%;
        transform: translateY(-50%);
        background: transparent;
        color: var(--color-cream);
        opacity: 0.7;
        border: 0;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        font-size: var(--text-xs);
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .password-form__field {
        position: relative;
        display: flex;
        align-items: stretch;
      }

      .password-form__field input { width: 100%; }

      .password-form__toggle {
        background: transparent;
        color: var(--color-cream);
        opacity: 0.7;
        border: 1px solid var(--color-cream);
        border-left-width: 0;
        padding: 0 1rem;
        cursor: pointer;
        font-size: var(--text-xs);
        letter-spacing: 0.12em;
        text-transform: uppercase;
        min-height: 48px;
      }

      .password-form__toggle:hover { opacity: 1; }

      .password-errors,
      .password-success {
        list-style: none;
        padding: 0.5rem 0.75rem;
        margin: 0 0 0.75rem;
        font-size: var(--text-sm);
        text-align: left;
      }

      .password-errors {
        color: #ffd6ce;
        background: rgba(179, 38, 30, 0.2);
        border-left: 3px solid #b3261e;
      }

      .password-success {
        color: var(--color-cream);
        background: rgba(154, 90, 60, 0.25);
        border-left: 3px solid var(--color-cognac);
      }

      .password-social {
        display: flex;
        gap: 1.5rem;
        justify-content: center;
        margin-top: 2rem;
        font-size: var(--text-xs);
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .password-social a {
        color: var(--color-cream);
        text-decoration: none;
        border-bottom: 1px solid rgba(245, 239, 230, 0.35);
        padding-bottom: 2px;
        transition: opacity 200ms ease;
        opacity: 0.75;
      }

      .password-social a:hover { opacity: 1; }

      .password-footer {
        padding: 1.5rem 1rem 1.25rem;
        text-align: center;
        font-size: var(--text-xs);
        letter-spacing: 0.15em;
        text-transform: uppercase;
        opacity: 0.55;
        position: relative;
        z-index: 1;
      }

      .password-footer a { color: inherit; border-bottom: 1px solid rgba(245, 239, 230, 0.3); }
    </style>
  </head>

  <body class="template-password">
    <a class="skip-to-content-link" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    {%- if settings.password_background_image != blank -%}
      <div class="password-bg" aria-hidden="true">
        <img src="{{ settings.password_background_image | image_url: width: 2400 }}"
             srcset="{{ settings.password_background_image | image_url: width: 900 }} 900w,
                     {{ settings.password_background_image | image_url: width: 1440 }} 1440w,
                     {{ settings.password_background_image | image_url: width: 2000 }} 2000w,
                     {{ settings.password_background_image | image_url: width: 2400 }} 2400w"
             sizes="100vw"
             alt=""
             loading="eager"
             fetchpriority="high">
      </div>
    {%- endif -%}

    <p class="password-admin-link">
      {{ 'general.password.admin_link_html' | t }}
    </p>

    <main id="MainContent" class="password-main" role="main" tabindex="-1">
      <div class="password-wrapper">
        <div class="password-logo">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 400 }}"
                 alt="{{ shop.name | escape }}"
                 width="200" height="auto">
          {%- else -%}
            <span>{{ settings.organization_name | default: shop.name | default: 'Orlaven' }}</span>
          {%- endif -%}
        </div>

        <p class="password-eyebrow">{{ 'general.password.opening_soon' | t }}</p>
        <h1 class="password-heading">
          {{ shop.password_page_opening_soon_html | default: 'Handcrafted. Since day one.' }}
        </h1>
        <p class="password-tagline">
          {%- if shop.password_message != blank -%}
            {{ shop.password_message }}
          {%- else -%}
            {{ 'general.password.tagline' | t }}
          {%- endif -%}
        </p>

        <div class="password-form-card">
          <h2 class="password-form-heading">{{ 'general.password.login_heading' | t }}</h2>
          <p class="password-form-subheading">{{ 'general.password.login_form_subheading' | t | default: 'Enter the password to continue.' }}</p>

          {%- form 'storefront_password', class: 'password-form' -%}
            {%- if form.errors -%}
              <ul class="password-errors" role="alert" tabindex="-1" autofocus>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
            <label for="Password" class="visually-hidden">{{ 'general.password.password_label' | t }}</label>
            <div class="password-form__field">
              <input
                type="password"
                name="password"
                id="Password"
                autocomplete="current-password"
                placeholder="{{ 'general.password.password_placeholder' | t }}"
                aria-describedby="PasswordHelp"
                {% if form.errors %}aria-invalid="true"{% endif %}
                required>
              <button type="button"
                      class="password-form__toggle"
                      data-password-toggle
                      aria-label="{{ 'general.password.show_password' | t | default: 'Show password' }}"
                      aria-pressed="false">
                {{ 'general.password.show' | t | default: 'Show' }}
              </button>
            </div>
            <button type="submit">{{ 'general.password.submit' | t }}</button>
          {%- endform -%}
        </div>

        <div class="password-form-card">
          <h2 class="password-form-heading">{{ 'general.password.signup_form_heading' | t }}</h2>
          <p class="password-form-subheading">{{ 'general.newsletter.password_prompt' | t }}</p>

          {%- form 'customer', class: 'password-form' -%}
            <input type="hidden" name="contact[tags]" value="waitlist,password-page">
            {%- if form.errors -%}
              <ul class="password-errors" role="alert">
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            {%- elsif form.posted_successfully? -%}
              <p class="password-success" role="status">{{ 'general.newsletter.success' | t }}</p>
            {%- endif -%}
            <label for="NewsletterEmail" class="visually-hidden">{{ 'general.newsletter.email_label' | t }}</label>
            <div class="password-form__field">
              <input
                type="email"
                name="contact[email]"
                id="NewsletterEmail"
                autocomplete="email"
                placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
                {% if form.errors %}aria-invalid="true"{% endif %}
                required>
            </div>
            <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
          {%- endform -%}
        </div>

        <div class="password-social">
          {%- if settings.social_instagram_link != blank -%}
            <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>
          {%- endif -%}
          {%- if settings.social_facebook_link != blank -%}
            <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>
          {%- endif -%}
          {%- if settings.social_pinterest_link != blank -%}
            <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a>
          {%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}
            <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a>
          {%- endif -%}
          {%- if settings.social_youtube_link != blank -%}
            <a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a>
          {%- endif -%}
        </div>
      </div>
    </main>

    <footer class="password-footer">
      <p>
        &copy; {{ 'now' | date: '%Y' }} {{ settings.organization_name | default: shop.name }}.
        {{ 'general.password.all_rights_reserved' | t }}
        &nbsp;&middot;&nbsp;
        <a href="https://www.shopify.com" target="_blank" rel="noopener">{{ 'general.password.powered_by' | t }}</a>
      </p>
    </footer>

    <script>
      (function () {
        var toggle = document.querySelector('[data-password-toggle]');
        if (!toggle) return;
        var input = document.getElementById('Password');
        if (!input) return;
        toggle.addEventListener('click', function () {
          var isPw = input.type === 'password';
          input.type = isPw ? 'text' : 'password';
          toggle.setAttribute('aria-pressed', isPw ? 'true' : 'false');
          toggle.textContent = isPw ? 'Hide' : 'Show';
        });

        // Surface the newsletter success message next to the form input
        // by focusing it after posting. The `autofocus` attribute on the
        // error block handles the error case above.
        var successEl = document.querySelector('.password-success');
        if (successEl) {
          successEl.focus && successEl.focus();
        }
      }());
    </script>
  </body>
</html>
