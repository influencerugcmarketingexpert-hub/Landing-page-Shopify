<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="{{ settings.color_background | default: '#FFFFFF' }}">

    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }} &ndash; {{ 'general.password.opening_soon' | t }}</title>
    <meta name="description" content="{{ shop.description | default: shop.name | escape }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&display=swap">

    {{ 'base.css' | asset_url | stylesheet_tag }}

    <style>
      :root {
        --color-espresso: {{ settings.color_espresso | default: '#2B1F17' }};
        --color-cognac: {{ settings.color_cognac | default: '#9A5A3C' }};
        --color-cream: {{ settings.color_cream | default: '#F5EFE6' }};
        --color-ink: {{ settings.color_ink | default: '#0F0F0F' }};
        --color-beige: {{ settings.color_beige | default: '#E8DFD2' }};
        --color-background: {{ settings.color_background | default: '#FFFFFF' }};
        --color-text: {{ settings.color_text | default: '#0F0F0F' }};
        --color-accent: {{ settings.color_accent | default: '#9A5A3C' }};
        --color-button: {{ settings.color_button | default: '#2B1F17' }};
        --color-button-text: {{ settings.color_button_text | default: '#F5EFE6' }};
        --font-heading: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
        --font-body: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
        --page-width: {{ settings.page_width | default: 1440 }}px;
      }

      body.template-password {
        background: var(--color-espresso);
        color: var(--color-cream);
        font-family: var(--font-body);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        margin: 0;
      }

      .password-wrapper {
        max-width: 520px;
        width: 100%;
        text-align: center;
      }

      .password-logo {
        margin: 0 0 2rem;
        font-family: var(--font-heading);
        font-size: 2.5rem;
        letter-spacing: 0.2em;
        text-transform: uppercase;
      }

      .password-logo img {
        max-width: 180px;
        height: auto;
      }

      .password-heading {
        font-family: var(--font-heading);
        font-size: clamp(2rem, 4vw, 3rem);
        font-weight: 500;
        margin: 0 0 1rem;
      }

      .password-tagline {
        font-size: 1rem;
        margin: 0 0 2.5rem;
        opacity: 0.8;
      }

      .password-form {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        max-width: 360px;
        margin: 0 auto 2rem;
      }

      .password-form input[type="email"],
      .password-form input[type="password"] {
        background: transparent;
        border: 1px solid var(--color-cream);
        color: var(--color-cream);
        padding: 0.9rem 1rem;
        font: inherit;
        letter-spacing: 0.05em;
      }

      .password-form input::placeholder {
        color: var(--color-cream);
        opacity: 0.6;
      }

      .password-form button {
        background: var(--color-cream);
        color: var(--color-espresso);
        border: none;
        padding: 0.9rem 1rem;
        font: inherit;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        cursor: pointer;
      }

      .password-social {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 1.5rem;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .password-social a {
        color: var(--color-cream);
        text-decoration: none;
        border-bottom: 1px solid rgba(245, 239, 230, 0.4);
        padding-bottom: 2px;
      }

      .password-footer {
        margin-top: 3rem;
        font-size: 0.8rem;
        opacity: 0.6;
        text-align: center;
      }

      .password-errors {
        list-style: none;
        padding: 0;
        margin: 0 0 1rem;
        color: var(--color-cognac);
      }
    </style>
  </head>

  <body class="template-password">
    <a class="skip-to-content-link visually-hidden" href="#MainContent">
      {{ 'general.accessibility.skip_to_content' | t }}
    </a>

    <main id="MainContent" class="password-wrapper" role="main">
      <div class="password-logo">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: 360 }}" alt="{{ shop.name | escape }}" width="180" height="auto">
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </div>

      <h1 class="password-heading">{{ 'general.password.opening_soon' | t }}</h1>
      <p class="password-tagline">{{ shop.password_message | default: 'general.password.tagline' | t }}</p>

      {%- form 'storefront_password', class: 'password-form' -%}
        {%- if form.errors -%}
          <ul class="password-errors" role="alert">
            {%- for field in form.errors -%}
              <li>{{ form.errors.messages[field] }}</li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        <label for="Password" class="visually-hidden">{{ 'general.password.password_label' | t }}</label>
        <input
          type="password"
          name="password"
          id="Password"
          autocomplete="current-password"
          placeholder="{{ 'general.password.password_placeholder' | t }}"
          required>
        <button type="submit">{{ 'general.password.submit' | t }}</button>
      {%- endform -%}

      <div class="password-newsletter">
        <p>{{ 'general.newsletter.password_prompt' | t }}</p>
        {%- form 'customer', class: 'password-form' -%}
          <input type="hidden" name="contact[tags]" value="prospect,password-page">
          <label for="NewsletterEmail" class="visually-hidden">{{ 'general.newsletter.email_label' | t }}</label>
          <input
            type="email"
            name="contact[email]"
            id="NewsletterEmail"
            autocomplete="email"
            placeholder="{{ 'general.newsletter.email_placeholder' | t }}"
            required>
          <button type="submit">{{ 'general.newsletter.submit' | t }}</button>
          {%- if form.posted_successfully? -%}
            <p class="password-success">{{ 'general.newsletter.success' | t }}</p>
          {%- endif -%}
        {%- endform -%}
      </div>

      <div class="password-social">
        {%- if settings.social_instagram_link != blank -%}
          <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>
        {%- endif -%}
        {%- if settings.social_facebook_link != blank -%}
          <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>
        {%- endif -%}
        {%- if settings.social_pinterest_link != blank -%}
          <a href="{{ settings.social_pinterest_link }}" target="_blank" rel="noopener">Pinterest</a>
        {%- endif -%}
        {%- if settings.social_tiktok_link != blank -%}
          <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a>
        {%- endif -%}
      </div>
    </main>

    <footer class="password-footer">
      <p>&copy; {{ 'now' | date: '%Y' }} {{ settings.organization_name | default: shop.name }}. {{ 'general.password.all_rights_reserved' | t }}</p>
    </footer>
  </body>
</html>
